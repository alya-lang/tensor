## Demo of the tensor package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya"

let t = Tensor.from_array([2, 2], [1.0, 2.0, 3.0, 4.0])
say "Tensor 2x2 created:"
say t.get_2d(0, 0)
say t.get_2d(0, 1)
say t.get_2d(1, 0)
say t.get_2d(1, 1)

let t2 = t.matmul(t)
say "Squared via matmul:"
say t2.get_2d(0, 0)
say t2.get_2d(1, 1)

t.free()
t2.free()
say "Done!"
