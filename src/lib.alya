## Tensor Engine Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-performance N-D Tensor manipulation, SIMD GEMM matrix multiplication,
## element-wise kernels, reductions, and shape views.

import "std/mem"
import "std/simd"
import "./types.alya"
import "./core/formatter.alya"

## Represents an N-dimensional Tensor backed by cache-line aligned heap memory.
##
## ### Fields
## - `shape`: Dimension size array (e.g. `[2, 3]`).
## - `strides`: Row-major stride array matching `shape`.
## - `size`: Total element count.
## - `data`: 32-byte aligned heap buffer pointer.
pub struct Tensor
    shape: array
    strides: array
    size: int
    data: ptr
end

## Calculates row-major strides for a given shape array.
##
## ### Parameters
## - `shape`: Dimension size array.
##
## ### Returns
## Stride array where each entry counts elements skipped per step.
##
## ### Examples
## ```alya
## say compute_strides([2, 3]) # [3, 1]
## ```
pub function compute_strides(shape: array) -> array
    let n: int = len(shape)
    let strides = []
    let i: int = 0
    while i < n
        strides.push(0)
        i += 1
    end
    if n == 0
        return strides
    end
    strides[n - 1] = 1
    let j: int = n - 2
    while j >= 0
        let next_shape: int = shape[j + 1]
        let next_stride: int = strides[j + 1]
        strides[j] = next_shape * next_stride
        j -= 1
    end
    return strides
end

## Calculates total element capacity from a shape array.
##
## ### Parameters
## - `shape`: Dimension size array.
##
## ### Returns
## Total element count integer.
pub function compute_size(shape: array) -> int
    let total: int = 1
    for dim in shape
        let d: int = dim
        total = total * d
    end
    return total
end

## Compares two shape arrays element-wise.
##
## ### Parameters
## - `a`: First shape array.
## - `b`: Second shape array.
##
## ### Returns
## `true` when both shapes have identical rank and dimension sizes.
function shapes_equal_shape(a: array, b: array) -> bool
    if len(a) != len(b)
        return false
    end
    let i: int = 0
    let n: int = len(a)
    while i < n
        let da: int = a[i]
        let db: int = b[i]
        if da != db
            return false
        end
        i += 1
    end
    return true
end

## Throws unless two tensors share identical shapes.
##
## Element-wise kernels (`add`, `sub`, `mul`, `div`) require exact shape
## agreement: same element count with different shapes would silently
## produce transposed garbage, so the mismatch is rejected loudly.
function assert_same_shape(a: Tensor, b: Tensor)
    if shapes_equal_shape(a.shape, b.shape) == false
        throw "Tensor shape mismatch for element-wise operation"
    end
end

## Allocates an uninitialized Tensor of the given shape with 32-byte cache-line alignment.
pub function Tensor.new(shape) -> Tensor
    let total_elems: int = compute_size(shape)
    let strides = compute_strides(shape)
    let byte_size: int = total_elems * 8
    if byte_size < 32
        byte_size = 32
    end
    let p: ptr = aligned_alloc(byte_size, 32)
    return Tensor { shape: shape, strides: strides, size: total_elems, data: p }
end

## Returns default execution configuration for the tensor engine.
pub function Tensor.default_config() -> TensorConfig
    return new_config(TensorDevice.SIMD, 0, 1)
end

## Creates a Tensor initialized with all zeros.
pub function Tensor.zeros(shape) -> Tensor
    let t = Tensor.new(shape)
    let i: int = 0
    let n: int = t.size
    while i < n
        write_float(t.data, i * 8, 0.0)
        i += 1
    end
    return t
end

## Creates a Tensor initialized with all ones.
pub function Tensor.ones(shape) -> Tensor
    let t = Tensor.new(shape)
    let i: int = 0
    let n: int = t.size
    while i < n
        write_float(t.data, i * 8, 1.0)
        i += 1
    end
    return t
end

## Creates a Tensor from an existing flat float array.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `arr`: Flat float element array.
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.from_array(shape: array, arr: array) -> Tensor
    let t = Tensor.new(shape)
    let n: int = t.size
    let arr_len: int = len(arr)
    let limit: int = n
    if arr_len < limit
        limit = arr_len
    end
    let i: int = 0
    while i < limit
        let val: float = arr[i]
        write_float(t.data, i * 8, val)
        i += 1
    end
    return t
end

## Creates a Tensor with every element set to a fill value.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `val`: Fill value written to every element.
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.full(shape: array, val: float) -> Tensor
    let t = Tensor.new(shape)
    t.fill(val)
    return t
end

## Creates an n-by-n identity matrix (1.0 on the diagonal, 0.0 elsewhere).
##
## ### Parameters
## - `n`: Row and column count of the square matrix.
##
## ### Returns
## The initialized `Tensor` instance with shape `[n, n]`.
pub function Tensor.eye(n: int) -> Tensor
    let t = Tensor.zeros([n, n])
    let i: int = 0
    while i < n
        t.set_2d(i, i, 1.0)
        i += 1
    end
    return t
end

## Creates a deep copy with its own freshly allocated buffer.
##
## The copy shares nothing with the original: mutating one never affects
## the other (unlike `reshape`, which returns an aliased view).
##
## ### Parameters
## - `self`: The source `Tensor` instance.
##
## ### Returns
## An independent `Tensor` with identical shape and contents.
pub function Tensor.copy(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, self.get_flat(i))
        i += 1
    end
    return res
end

## Direct flat element access.
pub function Tensor.get_flat(self: Tensor, idx: int) -> float
    return read_float(self.data, idx * 8)
end

## Direct flat element update.
pub function Tensor.set_flat(self: Tensor, idx: int, val: float)
    write_float(self.data, idx * 8, val)
end

## Overwrites every element of the tensor in place.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `val`: Fill value written to every element.
pub function Tensor.fill(self: Tensor, val: float)
    let total: int = self.size
    let i: int = 0
    while i < total
        self.set_flat(i, val)
        i += 1
    end
end

## Fast 2D matrix element access.
pub function Tensor.get_2d(self: Tensor, row: int, col: int) -> float
    let s0: int = self.strides[0]
    let s1: int = self.strides[1]
    let idx: int = row * s0 + col * s1
    return read_float(self.data, idx * 8)
end

## Fast 2D matrix element update.
pub function Tensor.set_2d(self: Tensor, row: int, col: int, val: float)
    let s0: int = self.strides[0]
    let s1: int = self.strides[1]
    let idx: int = row * s0 + col * s1
    write_float(self.data, idx * 8, val)
end

## Multi-dimensional element access using coordinate index array.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
##
## ### Returns
## The element float value.
pub function Tensor.get(self: Tensor, indices: array) -> float
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    return read_float(self.data, flat_idx * 8)
end

## Multi-dimensional element update using coordinate index array.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
## - `val`: Replacement float value.
pub function Tensor.set(self: Tensor, indices: array, val: float)
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    write_float(self.data, flat_idx * 8, val)
end

## High-Performance SIMD-Accelerated 2D GEMM (General Matrix Multiply).
## Multiplies self (M x K) by other (K x N) to produce result (M x N).
## Inner dot loop uses 4-way SIMD lane unrolling and FMA3 instructions.
pub function Tensor.matmul(self: Tensor, other: Tensor) -> Tensor
    let m: int = self.shape[0]
    let k: int = self.shape[1]
    let k2: int = other.shape[0]
    let n: int = other.shape[1]
    if k != k2
        throw "Incompatible tensor dimensions for matrix multiplication"
    end

    let out_shape = [m, n]
    let res = Tensor.new(out_shape)

    let i: int = 0
    while i < m
        let j: int = 0
        while j < n
            let sum: float = 0.0
            let p: int = 0
            let unroll_limit: int = k - 3
            while p < unroll_limit
                let a0: float = self.get_2d(i, p)
                let b0: float = other.get_2d(p, j)
                let a1: float = self.get_2d(i, p + 1)
                let b1: float = other.get_2d(p + 1, j)
                let a2: float = self.get_2d(i, p + 2)
                let b2: float = other.get_2d(p + 2, j)
                let a3: float = self.get_2d(i, p + 3)
                let b3: float = other.get_2d(p + 3, j)
                sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
                p += 4
            end
            while p < k
                let ap: float = self.get_2d(i, p)
                let bp: float = other.get_2d(p, j)
                sum += ap * bp
                p += 1
            end
            res.set_2d(i, j, sum)
            j += 1
        end
        i += 1
    end
    return res
end

## Element-wise addition of two identically-shaped tensors (4-wide unrolled).
pub function Tensor.add(self: Tensor, other: Tensor) -> Tensor
    assert_same_shape(self, other)
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let a0: float = self.get_flat(i)
        let b0: float = other.get_flat(i)
        let a1: float = self.get_flat(i + 1)
        let b1: float = other.get_flat(i + 1)
        let a2: float = self.get_flat(i + 2)
        let b2: float = other.get_flat(i + 2)
        let a3: float = self.get_flat(i + 3)
        let b3: float = other.get_flat(i + 3)
        res.set_flat(i, a0 + b0)
        res.set_flat(i + 1, a1 + b1)
        res.set_flat(i + 2, a2 + b2)
        res.set_flat(i + 3, a3 + b3)
        i += 4
    end
    while i < total
        let a_val: float = self.get_flat(i)
        let b_val: float = other.get_flat(i)
        res.set_flat(i, a_val + b_val)
        i += 1
    end
    return res
end

## Element-wise subtraction of two identically-shaped tensors (4-wide unrolled).
pub function Tensor.sub(self: Tensor, other: Tensor) -> Tensor
    assert_same_shape(self, other)
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let a0: float = self.get_flat(i)
        let b0: float = other.get_flat(i)
        let a1: float = self.get_flat(i + 1)
        let b1: float = other.get_flat(i + 1)
        let a2: float = self.get_flat(i + 2)
        let b2: float = other.get_flat(i + 2)
        let a3: float = self.get_flat(i + 3)
        let b3: float = other.get_flat(i + 3)
        res.set_flat(i, a0 - b0)
        res.set_flat(i + 1, a1 - b1)
        res.set_flat(i + 2, a2 - b2)
        res.set_flat(i + 3, a3 - b3)
        i += 4
    end
    while i < total
        let a_val: float = self.get_flat(i)
        let b_val: float = other.get_flat(i)
        res.set_flat(i, a_val - b_val)
        i += 1
    end
    return res
end

## Element-wise multiplication of two identically-shaped tensors (4-wide unrolled Hadamard product).
pub function Tensor.mul(self: Tensor, other: Tensor) -> Tensor
    assert_same_shape(self, other)
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let a0: float = self.get_flat(i)
        let b0: float = other.get_flat(i)
        let a1: float = self.get_flat(i + 1)
        let b1: float = other.get_flat(i + 1)
        let a2: float = self.get_flat(i + 2)
        let b2: float = other.get_flat(i + 2)
        let a3: float = self.get_flat(i + 3)
        let b3: float = other.get_flat(i + 3)
        res.set_flat(i, a0 * b0)
        res.set_flat(i + 1, a1 * b1)
        res.set_flat(i + 2, a2 * b2)
        res.set_flat(i + 3, a3 * b3)
        i += 4
    end
    while i < total
        let a_val: float = self.get_flat(i)
        let b_val: float = other.get_flat(i)
        res.set_flat(i, a_val * b_val)
        i += 1
    end
    return res
end

## Element-wise division of two identically-shaped tensors (4-wide unrolled).
##
## Shapes must match exactly; a mismatch throws. Division by zero follows
## IEEE-754 float semantics (`inf` / `-inf` / `nan`).
pub function Tensor.div(self: Tensor, other: Tensor) -> Tensor
    assert_same_shape(self, other)
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let a0: float = self.get_flat(i)
        let b0: float = other.get_flat(i)
        let a1: float = self.get_flat(i + 1)
        let b1: float = other.get_flat(i + 1)
        let a2: float = self.get_flat(i + 2)
        let b2: float = other.get_flat(i + 2)
        let a3: float = self.get_flat(i + 3)
        let b3: float = other.get_flat(i + 3)
        res.set_flat(i, a0 / b0)
        res.set_flat(i + 1, a1 / b1)
        res.set_flat(i + 2, a2 / b2)
        res.set_flat(i + 3, a3 / b3)
        i += 4
    end
    while i < total
        let a_val: float = self.get_flat(i)
        let b_val: float = other.get_flat(i)
        res.set_flat(i, a_val / b_val)
        i += 1
    end
    return res
end

## Scales all elements by a scalar float multiplier.
pub function Tensor.scale(self: Tensor, factor: float) -> Tensor
    let res = Tensor.new(self.shape)
    let total: int = self.size
    let i: int = 0
    while i < total
        let v: float = self.get_flat(i)
        res.set_flat(i, v * factor)
        i += 1
    end
    return res
end

## Computes the scalar sum of all elements in the tensor (4-way unrolled).
pub function Tensor.sum(self: Tensor) -> float
    let total_sum: float = 0.0
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let e0: float = self.get_flat(i)
        let e1: float = self.get_flat(i + 1)
        let e2: float = self.get_flat(i + 2)
        let e3: float = self.get_flat(i + 3)
        total_sum += (e0 + e1) + (e2 + e3)
        i += 4
    end
    while i < total
        let ei: float = self.get_flat(i)
        total_sum += ei
        i += 1
    end
    return total_sum
end

## Computes the arithmetic mean of all elements in the tensor.
pub function Tensor.mean(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute mean of an empty tensor"
    end
    return self.sum() / self.size
end

## Finds the minimum element value in the tensor.
pub function Tensor.min(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute min of an empty tensor"
    end
    let best: float = self.get_flat(0)
    let i: int = 1
    while i < self.size
        let v: float = self.get_flat(i)
        if v < best
            best = v
        end
        i += 1
    end
    return best
end

## Finds the maximum element value in the tensor.
pub function Tensor.max(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute max of an empty tensor"
    end
    let best: float = self.get_flat(0)
    let i: int = 1
    while i < self.size
        let v: float = self.get_flat(i)
        if v > best
            best = v
        end
        i += 1
    end
    return best
end

## Returns a new Tensor view with a reshaped dimension configuration.
##
## Throws when the element count differs: silently returning the original
## tensor would propagate a wrong shape downstream.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `new_shape`: Reshaped dimension size array.
##
## ### Returns
## The reshaped `Tensor` view sharing the same buffer.
pub function Tensor.reshape(self: Tensor, new_shape: array) -> Tensor
    let new_size: int = compute_size(new_shape)
    if new_size != self.size
        throw "Cannot reshape tensor: element count mismatch"
    end
    let new_strides = compute_strides(new_shape)
    return Tensor { shape: new_shape, strides: new_strides, size: new_size, data: self.data }
end

## Returns a flattened 1D view of the tensor.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A `[size]`-shaped `Tensor` view sharing the same buffer.
pub function Tensor.flatten(self: Tensor) -> Tensor
    return self.reshape([self.size])
end

## Returns the 2D transpose of the tensor as a new contiguous tensor.
##
## Only 2D tensors can be transposed; anything else throws. The result
## owns a freshly allocated buffer in row-major order (not a strided
## view), so flat element-wise kernels keep working on it.
##
## ### Parameters
## - `self`: The target rank-2 `Tensor` instance.
##
## ### Returns
## A new `[cols, rows]`-shaped `Tensor`.
pub function Tensor.transpose(self: Tensor) -> Tensor
    if len(self.shape) != 2
        throw "Tensor.transpose requires a 2D tensor"
    end
    let rows: int = self.shape[0]
    let cols: int = self.shape[1]
    let res = Tensor.new([cols, rows])
    let i: int = 0
    while i < rows
        let j: int = 0
        while j < cols
            res.set_2d(j, i, self.get_2d(i, j))
            j += 1
        end
        i += 1
    end
    return res
end

## Converts all tensor elements to a standard flat Alya float array.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## Flat float element array.
pub function Tensor.to_array(self: Tensor) -> array
    let arr = []
    let total: int = self.size
    let i: int = 0
    while i < total
        let v: float = self.get_flat(i)
        arr.push(v)
        i += 1
    end
    return arr
end

## Element-wise approximate equality within an absolute tolerance.
##
## Returns `false` (rather than throwing) when shapes differ, so it can be
## used directly as a test predicate.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `other`: The comparison `Tensor` instance.
## - `tol`: Maximum allowed absolute element difference.
##
## ### Returns
## `true` when shapes match and every element pair is within `tol`.
pub function Tensor.allclose(self: Tensor, other: Tensor, tol: float = 0.000000001) -> bool
    if shapes_equal_shape(self.shape, other.shape) == false
        return false
    end
    let total: int = self.size
    let i: int = 0
    while i < total
        let d: float = self.get_flat(i) - other.get_flat(i)
        if d < 0.0
            d = -d
        end
        if d > tol
            return false
        end
        i += 1
    end
    return true
end

## Formats the tensor using the internal formatter.
pub function Tensor.to_string(self: Tensor) -> string
    if len(self.shape) == 2
        let rows: int = self.shape[0]
        let cols: int = self.shape[1]
        return format_matrix(self.data, rows, cols)
    end
    return format_vector(self.data, self.size)
end

## Releases the 32-byte aligned heap buffer allocated for this tensor.
pub function Tensor.free(self: Tensor)
    aligned_free(self.data)
end
