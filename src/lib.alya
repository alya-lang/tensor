## Tensor Engine Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-performance N-D Tensor manipulation, SIMD GEMM matrix multiplication,
## element-wise kernels, reductions, and shape views.

import "std/mem"
import "std/simd"
import "std/math"
import "std/str"
import "./types.alya"
import "./core/formatter.alya"
import "./core/device.alya"

## Device placement tags mirroring `TensorDevice` (`0` = CPU, `1` = SIMD,
## `2` = GPU). Stored per tensor; Phase 0 computes on CPU/SIMD regardless
## (see `src/core/device.alya`) — placement is forward-compatible tagging
## plus explicit transfer points, not execution yet.

## Represents an N-dimensional Tensor backed by cache-line aligned heap memory.
##
## Storage dtype is fixed at construction (`0` = Float64, `1` = Float32,
## `2` = Int32, `3` = Int64); element-wise operations require identical
## dtypes on both sides and throw otherwise (no implicit promotion).
##
## ### Fields
## - `shape`: Dimension size array (e.g. `[2, 3]`).
## - `strides`: Row-major stride array matching `shape`.
## - `size`: Total element count.
## - `dtype`: Storage dtype tag (`TensorDtype` integer value).
## - `device_id`: Execution placement tag (`TensorDevice` integer value).
## - `data`: 32-byte aligned heap buffer pointer.
pub struct Tensor
    shape: array
    strides: array
    size: int
    dtype: int
    device_id: int
    data: ptr
end

## Calculates row-major strides for a given shape array.
##
## ### Parameters
## - `shape`: Dimension size array.
##
## ### Returns
## Stride array where each entry counts elements skipped per step.
##
## ### Examples
## ```alya
## say compute_strides([2, 3]) # [3, 1]
## ```
pub function compute_strides(shape: array) -> array
    let n: int = len(shape)
    let strides = []
    let i: int = 0
    while i < n
        strides.push(0)
        i += 1
    end
    if n == 0
        return strides
    end
    strides[n - 1] = 1
    let j: int = n - 2
    while j >= 0
        let next_shape: int = shape[j + 1]
        let next_stride: int = strides[j + 1]
        strides[j] = next_shape * next_stride
        j -= 1
    end
    return strides
end

## Calculates total element capacity from a shape array.
##
## ### Parameters
## - `shape`: Dimension size array.
##
## ### Returns
## Total element count integer.
pub function compute_size(shape: array) -> int
    let total: int = 1
    for dim in shape
        let d: int = dim
        total = total * d
    end
    return total
end

## Returns the storage width in bytes for a tensor dtype tag.
##
## ### Parameters
## - `dtype`: Dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
##
## ### Returns
## Bytes per element (`4` for 32-bit dtypes, `8` for 64-bit dtypes).
## Unknown tags fall back to `8` (Float64 layout).
pub function dtype_itemsize(dtype: int) -> int
    return when dtype
        is 1 => 4
        is 2 => 4
        is 3 => 8
        else => 8
    end
end

## Reports whether a dtype tag selects integer storage.
##
## ### Parameters
## - `dtype`: Dtype tag.
##
## ### Returns
## `true` for Int32 (`2`) and Int64 (`3`), `false` otherwise.
function dtype_is_int(dtype: int) -> bool
    return when dtype
        is 2 => true
        is 3 => true
        else => false
    end
end

## Reads one element as a float regardless of storage dtype.
##
## Integer storage converts to float; magnitudes below 2^53 convert exactly.
## Use `get_flat_int` for exact Int64 reads beyond that range.
function tensor_read_float(data: ptr, idx: int, dtype: int) -> float
    when dtype
        is 1 then return read_f32(data, idx * 4)
        is 2 then return read_i32(data, idx * 4) + 0.0
        is 3 then return read_int(data, idx * 8) + 0.0
        else return read_float(data, idx * 8)
    end
end

## Writes one element, converting the value to the storage dtype.
## Float-to-int conversion truncates toward zero (`int()` semantics).
## The value parameter is explicitly `float`: whole-program inference keys
## unannotated parameters by call-site types, so mixed int/float call sites
## would otherwise miscompile one side. Convert at the call site (`v + 0.0`).
function tensor_write_val(data: ptr, idx: int, dtype: int, val: float)
    when dtype
        is 1 then write_f32(data, idx * 4, val)
        is 2 then write_i32(data, idx * 4, int(val))
        is 3 then write_int(data, idx * 8, int(val))
        else write_float(data, idx * 8, val)
    end
end

## Reads one element as an exact integer (meaningful for integer storage;
## float storage truncates toward zero).
function tensor_read_int(data: ptr, idx: int, dtype: int)
    when dtype
        is 2 then return read_i32(data, idx * 4)
        else return read_int(data, idx * 8)
    end
end

## Writes one element from an integer value (integer storage only).
function tensor_write_int(data: ptr, idx: int, dtype: int, val)
    when dtype
        is 2 then write_i32(data, idx * 4, val)
        else write_int(data, idx * 8, val)
    end
end

## Compares two shape arrays element-wise.
##
## ### Parameters
## - `a`: First shape array.
## - `b`: Second shape array.
##
## ### Returns
## `true` when both shapes have identical rank and dimension sizes.
function shapes_equal_shape(a: array, b: array) -> bool
    if len(a) != len(b)
        return false
    end
    let i: int = 0
    let n: int = len(a)
    while i < n
        let da: int = a[i]
        let db: int = b[i]
        if da != db
            return false
        end
        i += 1
    end
    return true
end

## Throws unless two tensors share the same storage dtype.
##
## There is no implicit cross-dtype promotion: `Float32 + Int32` is a
## programming error, not a silent upcast. Convert explicitly via a
## same-dtype copy (`to_dtype`) before combining.
function assert_same_dtype(a: Tensor, b: Tensor)
    if a.dtype != b.dtype
        throw "Tensor dtype mismatch: element-wise operations require identical dtypes"
    end
end

## Computes the broadcast output shape of two shapes (right-aligned).
##
## Each trailing dimension pair must be equal or one of them `1`; a `1`
## stretches to the other size. Throws when a pair is incompatible.
##
## ### Parameters
## - `a`: First shape array.
## - `b`: Second shape array.
##
## ### Returns
## The broadcast output shape array.
##
## ### Throws
## Incompatible trailing dimension pair (both non-`1` and unequal).
pub function broadcast_shape(a: array, b: array) -> array
    let ra: int = len(a)
    let rb: int = len(b)
    let rank: int = ra
    if rb > rank
        rank = rb
    end
    let out = []
    let i: int = 0
    while i < rank
        out.push(1)
        i += 1
    end
    let k: int = 0
    while k < rank
        let da: int = 1
        let db: int = 1
        if k < ra
            da = a[ra - 1 - k]
        end
        if k < rb
            db = b[rb - 1 - k]
        end
        if da != 1 and db != 1 and da != db
            throw "Tensor shapes are not broadcast-compatible"
        end
        let dim: int = da
        if db > dim
            dim = db
        end
        out[rank - 1 - k] = dim
        k += 1
    end
    return out
end

## Copies `src` into `res`, stretching size-1 dimensions as needed.
##
## `res` must have the broadcast-compatible target shape; the copy is
## element-exact per dtype (integer storage never passes through float).
function broadcast_copy_into(src: Tensor, res: Tensor)
    let rank: int = len(res.shape)
    let srank: int = len(src.shape)
    let off: int = rank - srank
    let total: int = res.size
    let is_int: int = 0
    if dtype_is_int(src.dtype)
        is_int = 1
    end
    let i: int = 0
    while i < total
        let rem: int = i
        let d: int = rank - 1
        let src_idx: int = 0
        while d >= 0
            let dim: int = res.shape[d]
            let coord: int = rem % dim
            rem = (rem - coord) / dim
            let k: int = d - off
            if k >= 0
                let tdim: int = src.shape[k]
                src_idx += (coord % tdim) * src.strides[k]
            end
            d -= 1
        end
        if is_int == 1
            res.set_flat_int(i, src.get_flat_int(src_idx))
        else
            res.set_flat(i, src.get_flat(src_idx))
        end
        i += 1
    end
end

## Returns `t` itself when its shape already matches, otherwise a fresh
## contiguous tensor materialized to `shape`. The return type is annotated
## so method calls on the result keep resolving (tuple destructuring would
## erase the struct type and break method dispatch at link time).
## Pair with `materialized_is_temp` for the free discipline.
function materialized_for_shape(t: Tensor, shape: array) -> Tensor
    if shapes_equal_shape(t.shape, shape)
        return t
    end
    let res = Tensor.new(shape, t.dtype, t.device_id)
    broadcast_copy_into(t, res)
    return res
end

## Reports whether `materialized_for_shape` copied (`true`, caller frees)
## or borrowed `t` itself (`false`, caller must not free).
function materialized_is_temp(t: Tensor, shape: array) -> bool
    if shapes_equal_shape(t.shape, shape)
        return false
    end
    return true
end

## Reports whether a batched-GEMM operand pair is offload-ready.
##
## Offload needs inner-2D contiguity (`[K, 1]` / `[N, 1]` strides); batch
## bases are applied host-side, so any batch strides are fine. Conservative
## by design: non-contiguous views silently take the CPU strided path.
function mm_inner_contiguous(a_s0: int, a_s1: int, b_s0: int, b_s1: int, k: int, n: int) -> bool
    if a_s0 != k or a_s1 != 1
        return false
    end
    if b_s0 != n or b_s1 != 1
        return false
    end
    return true
end

## Throws unless two tensors share identical shapes.
##
## Element-wise kernels (`add`, `sub`, `mul`, `div`) require exact shape
## agreement: same element count with different shapes would silently
## produce transposed garbage, so the mismatch is rejected loudly.
function assert_same_shape(a: Tensor, b: Tensor)
    if shapes_equal_shape(a.shape, b.shape) == false
        throw "Tensor shape mismatch for element-wise operation"
    end
end

## Allocates an uninitialized Tensor of the given shape with 32-byte cache-line alignment.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `dtype`: Storage dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
## - `device`: Execution placement tag (`0` = CPU, `1` = SIMD, `2` = GPU).
##
## ### Throws
## Unknown dtype tag (expected `0..3`) or unknown device tag (expected `0..2`).
pub function Tensor.new(shape, dtype: int = 0, device: int = 0) -> Tensor
    if dtype < 0 or dtype > 3
        throw "Unknown tensor dtype tag (expected 0..3)"
    end
    if device < 0 or device > 2
        throw "Unknown tensor device tag (expected 0..2)"
    end
    let total_elems: int = compute_size(shape)
    let strides = compute_strides(shape)
    let itemsize: int = dtype_itemsize(dtype)
    let byte_size: int = total_elems * itemsize
    if byte_size < 32
        byte_size = 32
    end
    let p: ptr = aligned_alloc(byte_size, 32)
    return Tensor { shape: shape, strides: strides, size: total_elems, dtype: dtype, device_id: device, data: p }
end

## Returns default execution configuration for the tensor engine.
pub function Tensor.default_config() -> TensorConfig
    return new_config(TensorDevice.SIMD, 0, 1)
end

## Creates a Tensor initialized with all zeros.
pub function Tensor.zeros(shape, dtype: int = 0) -> Tensor
    let t = Tensor.new(shape, dtype)
    let i: int = 0
    let n: int = t.size
    while i < n
        t.set_flat(i, 0.0)
        i += 1
    end
    return t
end

## Creates a Tensor initialized with all ones.
pub function Tensor.ones(shape, dtype: int = 0) -> Tensor
    let t = Tensor.new(shape, dtype)
    let i: int = 0
    let n: int = t.size
    while i < n
        t.set_flat(i, 1.0)
        i += 1
    end
    return t
end

## Creates a Tensor from an existing flat float array.
##
## Elements must be floats (`[1.0, 2.0]`, not `[1, 2]`): the value crosses
## into explicitly-`float` storage and whole-program inference compiles
## each call site by its static type, so integers would arrive as raw bits.
## Use `from_array_int` for integer element arrays. Values convert to the
## storage dtype (float-to-int truncates toward zero).
##
## ### Parameters
## - `shape`: Dimension size array.
## - `arr`: Flat float element array.
## - `dtype`: Storage dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.from_array(shape: array, arr: array, dtype: int = 0) -> Tensor
    let t = Tensor.new(shape, dtype)
    let n: int = t.size
    let arr_len: int = len(arr)
    let limit: int = n
    if arr_len < limit
        limit = arr_len
    end
    let i: int = 0
    while i < limit
        let v: float = arr[i]
        t.set_flat(i, v)
        i += 1
    end
    return t
end

## Creates a Tensor from an existing flat integer array.
##
## The integer counterpart of `from_array`: elements must be ints, stored
## exactly (including Int64). Values convert to the storage dtype.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `arr`: Flat integer element array.
## - `dtype`: Storage dtype tag (`2` = Int32, `3` = Int64; defaults to Int32).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.from_array_int(shape: array, arr: array, dtype: int = 2) -> Tensor
    let t = Tensor.new(shape, dtype)
    let n: int = t.size
    let arr_len: int = len(arr)
    let limit: int = n
    if arr_len < limit
        limit = arr_len
    end
    let i: int = 0
    while i < limit
        let v: int = arr[i]
        t.set_flat_int(i, v)
        i += 1
    end
    return t
end

## Creates a 1D Tensor with values `[0, 1, ..., n-1]` (integer-exact).
##
## ### Parameters
## - `n`: Element count (shape `[n]`).
## - `dtype`: Storage dtype tag (`2` = Int32, `3` = Int64, float tags convert exactly).
##
## ### Returns
## The initialized rank-1 `Tensor` instance.
##
## ### Throws
## Negative element count.
pub function Tensor.arange(n: int, dtype: int = 2) -> Tensor
    if n < 0
        throw "Tensor.arange requires a non-negative count"
    end
    let t = Tensor.new([n], dtype)
    if dtype_is_int(dtype)
        let i: int = 0
        while i < n
            t.set_flat_int(i, i)
            i += 1
        end
        return t
    end
    let j: int = 0
    while j < n
        t.set_flat(j, float(j))
        j += 1
    end
    return t
end

## Creates a 1D Tensor with integer-stepped values from `start` (inclusive)
## to `stop` (exclusive): `start, start+step, ...`.
##
## Integer-exact for integer storage; throws on a zero step. A
## sign-mismatched range (e.g. ascending range with negative step) yields
## an empty tensor.
##
## ### Parameters
## - `start`: First value (inclusive).
## - `stop`: End bound (exclusive).
## - `step`: Step between values (non-zero).
## - `dtype`: Storage dtype tag (integer tags exact, float tags convert exactly).
##
## ### Returns
## The initialized rank-1 `Tensor` instance.
##
## ### Throws
## Zero step.
pub function Tensor.arange_step(start: int, stop: int, step: int, dtype: int = 2) -> Tensor
    if step == 0
        throw "Tensor.arange_step requires a non-zero step"
    end
    let span: int = stop - start
    let count: int = 0
    if (span > 0 and step > 0) or (span < 0 and step < 0)
        count = span / step
        if span % step != 0
            count += 1
        end
    end
    let t = Tensor.new([count], dtype)
    if dtype_is_int(dtype)
        let i: int = 0
        while i < count
            t.set_flat_int(i, start + i * step)
            i += 1
        end
        return t
    end
    let j: int = 0
    while j < count
        t.set_flat(j, float(start + j * step))
        j += 1
    end
    return t
end

## Creates a 1D Tensor with `num` evenly spaced values from `start` to
## `stop` (both inclusive).
##
## ### Parameters
## - `start`: First value.
## - `stop`: Last value.
## - `num`: Point count (must be positive; `1` yields `[start]`).
## - `dtype`: Storage dtype tag (integer storage truncates on store).
##
## ### Returns
## The initialized rank-1 `Tensor` instance.
##
## ### Throws
## Non-positive point count.
pub function Tensor.linspace(start: float, stop: float, num: int, dtype: int = 0) -> Tensor
    if num <= 0
        throw "Tensor.linspace requires a positive point count"
    end
    let t = Tensor.new([num], dtype)
    if num == 1
        t.set_flat(0, start)
        return t
    end
    let step: float = (stop - start) / (num - 1)
    let i: int = 0
    while i < num
        t.set_flat(i, start + float(i) * step)
        i += 1
    end
    return t
end

## Creates a Tensor with standard-normal random values (Box-Muller).
##
## Uses `std/math` `rand_float` as the uniform source; values are exact for
## float storage and truncate on store for integer storage.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `dtype`: Storage dtype tag (`0` = Float64, `1` = Float32, others convert).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.randn(shape, dtype: int = 0) -> Tensor
    let t = Tensor.new(shape, dtype)
    let total: int = t.size
    let i: int = 0
    while i + 1 < total
        let u1: float = 1.0 - rand_float()
        if u1 < 0.0000000001
            u1 = 0.0000000001
        end
        let u2: float = rand_float()
        let mag: float = native_sqrt(-2.0 * native_log(u1))
        let ang: float = 6.283185307179586 * u2
        t.set_flat(i, mag * native_cos(ang))
        t.set_flat(i + 1, mag * native_sin(ang))
        i += 2
    end
    if i < total
        let u1b: float = 1.0 - rand_float()
        if u1b < 0.0000000001
            u1b = 0.0000000001
        end
        let u2b: float = rand_float()
        t.set_flat(i, native_sqrt(-2.0 * native_log(u1b)) * native_cos(6.283185307179586 * u2b))
    end
    return t
end

## Creates a Tensor with every element set to a fill value.
##
## ### Parameters
## - `shape`: Dimension size array.
## - `val`: Fill value written to every element (converts to storage dtype).
## - `dtype`: Storage dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.full(shape: array, val: float, dtype: int = 0) -> Tensor
    let t = Tensor.new(shape, dtype)
    t.fill(val)
    return t
end

## Creates an n-by-n identity matrix (1 on the diagonal, 0 elsewhere).
##
## ### Parameters
## - `n`: Row and column count of the square matrix.
## - `dtype`: Storage dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
##
## ### Returns
## The initialized `Tensor` instance with shape `[n, n]`.
pub function Tensor.eye(n: int, dtype: int = 0) -> Tensor
    let t = Tensor.zeros([n, n], dtype)
    let i: int = 0
    while i < n
        t.set_2d(i, i, 1.0)
        i += 1
    end
    return t
end

## Creates a zero tensor matching a reference tensor's shape, dtype, and device.
##
## ### Parameters
## - `ref`: Reference `Tensor` instance (shape/dtype/device source; data ignored).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.zeros_like(ref: Tensor) -> Tensor
    let t = Tensor.zeros(ref.shape, ref.dtype)
    let placed = t.to(ref.device_id)
    t.free()
    return placed
end

## Creates a ones tensor matching a reference tensor's shape, dtype, and device.
##
## Placement follows the reference tensor.
##
## ### Parameters
## - `ref`: Reference `Tensor` instance (shape/dtype/device source; data ignored).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.ones_like(ref: Tensor) -> Tensor
    let t = Tensor.ones(ref.shape, ref.dtype)
    let placed = t.to(ref.device_id)
    t.free()
    return placed
end

## Creates a filled tensor matching a reference tensor's shape, dtype, and device.
##
## Placement follows the reference tensor.
##
## ### Parameters
## - `ref`: Reference `Tensor` instance (shape/dtype/device source; data ignored).
## - `val`: Fill value (converts to storage dtype).
##
## ### Returns
## The initialized `Tensor` instance.
pub function Tensor.full_like(ref: Tensor, val: float) -> Tensor
    let t = Tensor.full(ref.shape, val, ref.dtype)
    let placed = t.to(ref.device_id)
    t.free()
    return placed
end

## Builds an n-by-n diagonal matrix from a rank-1 tensor.
##
## ### Parameters
## - `self`: Rank-1 `Tensor` with `n` diagonal elements.
##
## ### Returns
## A new `[n, n]`-shaped `Tensor` with the elements on the main diagonal.
##
## ### Throws
## Non-rank-1 input.
pub function Tensor.diag(self: Tensor) -> Tensor
    if len(self.shape) != 1
        throw "Tensor.diag requires a rank-1 tensor"
    end
    let n: int = self.shape[0]
    let res = Tensor.zeros([n, n], self.dtype)
    let placed = res.to(self.device_id)
    res.free()
    let i: int = 0
    while i < n
        placed.set_2d(i, i, self.get_flat(i))
        i += 1
    end
    return placed
end

## Extracts the main diagonal of a 2D tensor as a rank-1 copy.
##
## For rectangular matrices the diagonal runs `min(rows, cols)` elements.
##
## ### Parameters
## - `self`: Rank-2 `Tensor` instance.
##
## ### Returns
## A new 1D `Tensor` holding the diagonal elements.
##
## ### Throws
## Non-2D input.
pub function Tensor.diagonal(self: Tensor) -> Tensor
    if len(self.shape) != 2
        throw "Tensor.diagonal requires a 2D tensor"
    end
    let rows: int = self.shape[0]
    let cols: int = self.shape[1]
    let n: int = rows
    if cols < n
        n = cols
    end
    let res = Tensor.new([n], self.dtype, self.device_id)
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < n
            res.set_flat_int(i, self.get_flat_int(i * self.strides[0] + i * self.strides[1]))
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < n
        res.set_flat(j, self.get_2d(j, j))
        j += 1
    end
    return res
end

## Returns the upper triangle (main diagonal and above) as a new tensor.
##
## Elements below diagonal `k` become zero. Follows NumPy offset semantics:
## `k = 0` keeps the main diagonal, `k = 1` starts above it.
##
## ### Parameters
## - `self`: Rank-2 `Tensor` instance.
## - `k`: Diagonal offset.
##
## ### Returns
## A new `[rows, cols]`-shaped `Tensor`.
##
## ### Throws
## Non-2D input.
pub function Tensor.triu(self: Tensor, k: int = 0) -> Tensor
    if len(self.shape) != 2
        throw "Tensor.triu requires a 2D tensor"
    end
    let res = self.copy()
    let rows: int = self.shape[0]
    let cols: int = self.shape[1]
    let is_int: int = 0
    if dtype_is_int(self.dtype)
        is_int = 1
    end
    let i: int = 0
    while i < rows
        let j: int = 0
        while j < cols
            if j - i < k
                if is_int == 1
                    res.set_flat_int(i * res.strides[0] + j * res.strides[1], 0)
                else
                    res.set_flat(i * res.strides[0] + j * res.strides[1], 0.0)
                end
            end
            j += 1
        end
        i += 1
    end
    return res
end

## Returns the lower triangle (main diagonal and below) as a new tensor.
##
## Elements above diagonal `k` become zero (NumPy offset semantics).
##
## ### Parameters
## - `self`: Rank-2 `Tensor` instance.
## - `k`: Diagonal offset.
##
## ### Returns
## A new `[rows, cols]`-shaped `Tensor`.
##
## ### Throws
## Non-2D input.
pub function Tensor.tril(self: Tensor, k: int = 0) -> Tensor
    if len(self.shape) != 2
        throw "Tensor.tril requires a 2D tensor"
    end
    let res = self.copy()
    let rows: int = self.shape[0]
    let cols: int = self.shape[1]
    let is_int: int = 0
    if dtype_is_int(self.dtype)
        is_int = 1
    end
    let i: int = 0
    while i < rows
        let j: int = 0
        while j < cols
            if j - i > k
                if is_int == 1
                    res.set_flat_int(i * res.strides[0] + j * res.strides[1], 0)
                else
                    res.set_flat(i * res.strides[0] + j * res.strides[1], 0.0)
                end
            end
            j += 1
        end
        i += 1
    end
    return res
end

## Creates a deep copy with its own freshly allocated buffer.
##
## The copy shares nothing with the original: mutating one never affects
## the other (unlike `reshape`, which returns an aliased view).
##
## ### Parameters
## - `self`: The source `Tensor` instance.
##
## ### Returns
## An independent `Tensor` with identical shape, dtype, and contents.
pub function Tensor.copy(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, self.get_flat(i))
        i += 1
    end
    return res
end

## Returns a copy of the tensor converted to another storage dtype.
##
## Conversion passes through float: Int64 magnitudes beyond 2^53 may lose
## precision, and float-to-int truncates toward zero.
##
## ### Parameters
## - `self`: The source `Tensor` instance.
## - `dtype`: Target storage dtype tag (`0` = Float64, `1` = Float32, `2` = Int32, `3` = Int64).
##
## ### Returns
## An independent `Tensor` with identical shape and converted contents.
pub function Tensor.to_dtype(self: Tensor, dtype: int) -> Tensor
    let res = Tensor.new(self.shape, dtype, self.device_id)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, self.get_flat(i))
        i += 1
    end
    return res
end

## Returns a copy of the tensor placed on another device.
##
## The transfer is an exact staged copy (same shape, dtype, and values on
## a fresh buffer tagged with `device`). Phase 0 has no accelerator
## backend, so a GPU-tagged tensor still computes on CPU/SIMD — check
## `is_accelerated` when placement must mean execution.
##
## ### Parameters
## - `self`: The source `Tensor` instance.
## - `device`: Target placement tag (`0` = CPU, `1` = SIMD, `2` = GPU).
##
## ### Returns
## An independent `Tensor` on the target device.
##
## ### Throws
## Unknown device tag (expected `0..2`).
pub function Tensor.to(self: Tensor, device: int) -> Tensor
    if device < 0 or device > 2
        throw "Unknown tensor device tag (expected 0..2)"
    end
    let res = Tensor.new(self.shape, self.dtype, device)
    broadcast_copy_into(self, res)
    return res
end

## Returns the execution placement tag of the tensor.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## `0` (CPU), `1` (SIMD), or `2` (GPU).
pub function Tensor.device_of(self: Tensor) -> int
    return self.device_id
end

## Reports whether this tensor is placed on a usable accelerator.
##
## Placement alone (`device_id == 2`) is tagging; execution additionally
## needs a registered native backend (`device_has_accelerator`). Phase 0
## always returns `false` for GPU tensors — the honest fallback signal.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## `true` only for GPU-placed tensors on machines with a backend.
pub function Tensor.is_accelerated(self: Tensor) -> bool
    if self.device_id != 2
        return false
    end
    return device_has_accelerator()
end

## Direct flat element access (integer storage converts to float;
## magnitudes below 2^53 convert exactly).
pub function Tensor.get_flat(self: Tensor, idx: int) -> float
    return tensor_read_float(self.data, idx, self.dtype)
end

## Direct flat element update (value converts to storage dtype).
pub function Tensor.set_flat(self: Tensor, idx: int, val: float)
    tensor_write_val(self.data, idx, self.dtype, val)
end

## Exact integer flat element access.
##
## Integer storage reads exactly (including Int64 beyond 2^53); float
## storage truncates toward zero.
pub function Tensor.get_flat_int(self: Tensor, idx: int)
    return tensor_read_int(self.data, idx, self.dtype)
end

## Integer flat element update (meaningful for integer storage).
pub function Tensor.set_flat_int(self: Tensor, idx: int, val)
    tensor_write_int(self.data, idx, self.dtype, val)
end

## Overwrites every element of the tensor in place.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `val`: Fill value written to every element (converts to storage dtype).
pub function Tensor.fill(self: Tensor, val: float)
    let total: int = self.size
    let i: int = 0
    while i < total
        self.set_flat(i, val)
        i += 1
    end
end

## Fast 2D matrix element access.
pub function Tensor.get_2d(self: Tensor, row: int, col: int) -> float
    let s0: int = self.strides[0]
    let s1: int = self.strides[1]
    let idx: int = row * s0 + col * s1
    return tensor_read_float(self.data, idx, self.dtype)
end

## Fast 2D matrix element update (value converts to storage dtype).
pub function Tensor.set_2d(self: Tensor, row: int, col: int, val: float)
    let s0: int = self.strides[0]
    let s1: int = self.strides[1]
    let idx: int = row * s0 + col * s1
    tensor_write_val(self.data, idx, self.dtype, val)
end

## Multi-dimensional element access using coordinate index array.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
##
## ### Returns
## The element float value.
pub function Tensor.get(self: Tensor, indices: array) -> float
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    return tensor_read_float(self.data, flat_idx, self.dtype)
end

## Multi-dimensional element update using coordinate index array.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
## - `val`: Replacement value (converts to storage dtype).
pub function Tensor.set(self: Tensor, indices: array, val: float)
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    tensor_write_val(self.data, flat_idx, self.dtype, val)
end

## Multi-dimensional exact integer element access.
##
## Integer storage reads exactly (including Int64 beyond 2^53); float
## storage truncates toward zero.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
##
## ### Returns
## The exact integer element value.
pub function Tensor.get_int(self: Tensor, indices: array)
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    return tensor_read_int(self.data, flat_idx, self.dtype)
end

## Multi-dimensional integer element update (integer storage).
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `indices`: Coordinate index array.
## - `val`: Replacement integer value.
pub function Tensor.set_int(self: Tensor, indices: array, val)
    let flat_idx: int = 0
    let i: int = 0
    let ndim: int = len(indices)
    while i < ndim
        let coord: int = indices[i]
        let st: int = self.strides[i]
        flat_idx += coord * st
        i += 1
    end
    tensor_write_int(self.data, flat_idx, self.dtype, val)
end

## High-Performance SIMD-Accelerated GEMM (General Matrix Multiply).
## Multiplies self (M x K) by other (K x N) to produce result (M x N).
## Inner dot loop uses 4-way SIMD lane unrolling and FMA3 instructions.
## Both operands must share the storage dtype; integer dtypes accumulate
## in exact integer arithmetic (overflow wraps, C-style).
## Rank-3+ inputs run batched GEMM: leading dimensions broadcast
## right-aligned (a `[B, M, K]` by `[K, N]` works, reusing the single
## matrix). Rank-1 inputs throw (use `sum` of an element-wise product for
## dot products).
##
## ### Throws
## Rank below 2, or mismatched inner (`K`) dimensions.
pub function Tensor.matmul(self: Tensor, other: Tensor) -> Tensor
    let ra: int = len(self.shape)
    let rb: int = len(other.shape)
    if ra < 2 or rb < 2
        throw "Tensor.matmul requires rank >= 2 (batched or 2D shapes)"
    end
    let m: int = self.shape[ra - 2]
    let k: int = self.shape[ra - 1]
    let k2: int = other.shape[rb - 2]
    let n: int = other.shape[rb - 1]
    if k != k2
        throw "Incompatible tensor dimensions for matrix multiplication"
    end
    assert_same_dtype(self, other)

    if ra == 2 and rb == 2
        let out_shape = [m, n]
        let res = Tensor.new(out_shape, self.dtype, self.device_id)

        let off_ok = false
        if self.strides[0] == k and self.strides[1] == 1 and other.strides[0] == n and other.strides[1] == 1
            off_ok = device_offload_matmul(self, other, res, 0, 0, 0, m, n, k)
        end
        if off_ok == false
            if dtype_is_int(self.dtype)
                return matmul_int_into(self, other, res, m, n, k)
            end

            let i: int = 0
            while i < m
                let j: int = 0
                while j < n
                    let sum: float = 0.0
                    let p: int = 0
                    let unroll_limit: int = k - 3
                    while p < unroll_limit
                        let a0: float = self.get_2d(i, p)
                        let b0: float = other.get_2d(p, j)
                        let a1: float = self.get_2d(i, p + 1)
                        let b1: float = other.get_2d(p + 1, j)
                        let a2: float = self.get_2d(i, p + 2)
                        let b2: float = other.get_2d(p + 2, j)
                        let a3: float = self.get_2d(i, p + 3)
                        let b3: float = other.get_2d(p + 3, j)
                        sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
                        p += 4
                    end
                    while p < k
                        let ap: float = self.get_2d(i, p)
                        let bp: float = other.get_2d(p, j)
                        sum += ap * bp
                        p += 1
                    end
                    res.set_2d(i, j, sum)
                    j += 1
                end
                i += 1
            end
        end
        return res
    end

    return matmul_batched(self, other, ra, rb, m, n, k)
end

## Returns the first `count` dimensions of a shape array.
function shape_prefix(shape: array, count: int) -> array
    let out = []
    let i: int = 0
    while i < count
        out.push(shape[i])
        i += 1
    end
    return out
end

## Batched GEMM core shared by `matmul` for rank-3+ inputs.
## Loops over broadcast batch positions and runs strided 2D products at
## per-batch buffer bases (views stay consistent through strides).
function matmul_batched(a: Tensor, b: Tensor, ra: int, rb: int, m: int, n: int, k: int) -> Tensor
    let batch_a = shape_prefix(a.shape, ra - 2)
    let batch_b = shape_prefix(b.shape, rb - 2)
    let out_batch = broadcast_shape(batch_a, batch_b)
    let ob: int = len(out_batch)
    let out_shape = []
    let d: int = 0
    while d < ob
        out_shape.push(out_batch[d])
        d += 1
    end
    out_shape.push(m)
    out_shape.push(n)
    let res = Tensor.new(out_shape, a.dtype, a.device_id)

    let a_s0: int = a.strides[ra - 2]
    let a_s1: int = a.strides[ra - 1]
    let b_s0: int = b.strides[rb - 2]
    let b_s1: int = b.strides[rb - 1]
    let aba: int = ra - 2
    let abb: int = rb - 2
    let inner_ok: int = 0
    if mm_inner_contiguous(a_s0, a_s1, b_s0, b_s1, k, n)
        inner_ok = 1
    end
    let total_batches: int = compute_size(out_batch)
    let f: int = 0
    while f < total_batches
        let rem: int = f
        let a_base: int = 0
        let b_base: int = 0
        let e: int = ob - 1
        while e >= 0
            let dim: int = out_batch[e]
            let coord: int = rem % dim
            rem = (rem - coord) / dim
            let rpos: int = (ob - 1) - e
            let ka: int = aba - 1 - rpos
            if ka >= 0
                let adim: int = a.shape[ka]
                a_base += (coord % adim) * a.strides[ka]
            end
            let kb: int = abb - 1 - rpos
            if kb >= 0
                let bdim: int = b.shape[kb]
                b_base += (coord % bdim) * b.strides[kb]
            end
            e -= 1
        end
        let launched: int = 0
        if inner_ok == 1
            if device_offload_matmul(a, b, res, a_base, b_base, f * m * n, m, n, k)
                launched = 1
            end
        end
        if launched == 0
            if dtype_is_int(a.dtype)
                matmul_batch_int_into(a, b, res, a_base, b_base, f * m * n, m, n, k, a_s0, a_s1, b_s0, b_s1, n)
            else
                matmul_batch_float_into(a, b, res, a_base, b_base, f * m * n, m, n, k, a_s0, a_s1, b_s0, b_s1, n)
            end
        end
        f += 1
    end
    return res
end

## One strided 2D float product at buffer bases (batched GEMM inner core).
function matmul_batch_float_into(a: Tensor, b: Tensor, res: Tensor, a_base: int, b_base: int, r_base: int, m: int, n: int, k: int, a_s0: int, a_s1: int, b_s0: int, b_s1: int, r_s0: int) -> Tensor
    let i: int = 0
    while i < m
        let j: int = 0
        while j < n
            let sum: float = 0.0
            let p: int = 0
            let unroll_limit: int = k - 3
            while p < unroll_limit
                let a0: float = a.get_flat(a_base + i * a_s0 + p * a_s1)
                let b0: float = b.get_flat(b_base + p * b_s0 + j * b_s1)
                let a1: float = a.get_flat(a_base + i * a_s0 + (p + 1) * a_s1)
                let b1: float = b.get_flat(b_base + (p + 1) * b_s0 + j * b_s1)
                let a2: float = a.get_flat(a_base + i * a_s0 + (p + 2) * a_s1)
                let b2: float = b.get_flat(b_base + (p + 2) * b_s0 + j * b_s1)
                let a3: float = a.get_flat(a_base + i * a_s0 + (p + 3) * a_s1)
                let b3: float = b.get_flat(b_base + (p + 3) * b_s0 + j * b_s1)
                sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
                p += 4
            end
            while p < k
                sum += a.get_flat(a_base + i * a_s0 + p * a_s1) * b.get_flat(b_base + p * b_s0 + j * b_s1)
                p += 1
            end
            res.set_flat(r_base + i * r_s0 + j, sum)
            j += 1
        end
        i += 1
    end
    return res
end

## One strided 2D integer product at buffer bases (batched GEMM inner core).
function matmul_batch_int_into(a: Tensor, b: Tensor, res: Tensor, a_base: int, b_base: int, r_base: int, m: int, n: int, k: int, a_s0: int, a_s1: int, b_s0: int, b_s1: int, r_s0: int) -> Tensor
    let i: int = 0
    while i < m
        let j: int = 0
        while j < n
            let sum = 0
            let p: int = 0
            let unroll_limit: int = k - 3
            while p < unroll_limit
                let a0 = a.get_flat_int(a_base + i * a_s0 + p * a_s1)
                let b0 = b.get_flat_int(b_base + p * b_s0 + j * b_s1)
                let a1 = a.get_flat_int(a_base + i * a_s0 + (p + 1) * a_s1)
                let b1 = b.get_flat_int(b_base + (p + 1) * b_s0 + j * b_s1)
                let a2 = a.get_flat_int(a_base + i * a_s0 + (p + 2) * a_s1)
                let b2 = b.get_flat_int(b_base + (p + 2) * b_s0 + j * b_s1)
                let a3 = a.get_flat_int(a_base + i * a_s0 + (p + 3) * a_s1)
                let b3 = b.get_flat_int(b_base + (p + 3) * b_s0 + j * b_s1)
                sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
                p += 4
            end
            while p < k
                sum += a.get_flat_int(a_base + i * a_s0 + p * a_s1) * b.get_flat_int(b_base + p * b_s0 + j * b_s1)
                p += 1
            end
            res.set_flat_int(r_base + i * r_s0 + j, sum)
            j += 1
        end
        i += 1
    end
    return res
end

## Integer-dtype GEMM core shared by `matmul` (exact integer accumulation).
## Uses strided 2D indexing (like the float path) so reshaped views behave
## identically in both dtypes.
function matmul_int_into(a: Tensor, b: Tensor, res: Tensor, m: int, n: int, k: int) -> Tensor
    let a_s0: int = a.strides[0]
    let a_s1: int = a.strides[1]
    let b_s0: int = b.strides[0]
    let b_s1: int = b.strides[1]
    let i: int = 0
    while i < m
        let j: int = 0
        while j < n
            let sum = 0
            let p: int = 0
            let unroll_limit: int = k - 3
            while p < unroll_limit
                let a0 = a.get_flat_int(i * a_s0 + p * a_s1)
                let b0 = b.get_flat_int(p * b_s0 + j * b_s1)
                let a1 = a.get_flat_int(i * a_s0 + (p + 1) * a_s1)
                let b1 = b.get_flat_int((p + 1) * b_s0 + j * b_s1)
                let a2 = a.get_flat_int(i * a_s0 + (p + 2) * a_s1)
                let b2 = b.get_flat_int((p + 2) * b_s0 + j * b_s1)
                let a3 = a.get_flat_int(i * a_s0 + (p + 3) * a_s1)
                let b3 = b.get_flat_int((p + 3) * b_s0 + j * b_s1)
                sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
                p += 4
            end
            while p < k
                sum += a.get_flat_int(i * a_s0 + p * a_s1) * b.get_flat_int(p * b_s0 + j * b_s1)
                p += 1
            end
            res.set_flat_int(i * n + j, sum)
            j += 1
        end
        i += 1
    end
    return res
end

## Element-wise addition with NumPy-style broadcasting (4-wide unrolled).
##
## Shapes broadcast right-aligned (size-1 dimensions stretch); incompatible
## shapes throw. A scalar adds via a `[1]` tensor: `t.add(Tensor.full([1], 2.0))`.
##
## ### Throws
## Broadcast-incompatible shapes, or dtype mismatch (no implicit promotion).
pub function Tensor.add(self: Tensor, other: Tensor) -> Tensor
    assert_same_dtype(self, other)
    let out_shape = broadcast_shape(self.shape, other.shape)
    let lhs = materialized_for_shape(self, out_shape)
    let rhs = materialized_for_shape(other, out_shape)
    let lhs_tmp = materialized_is_temp(self, out_shape)
    let rhs_tmp = materialized_is_temp(other, out_shape)
    let res = Tensor.new(out_shape, self.dtype, self.device_id)
    if device_offload_ew(lhs, rhs, res, res.size, 0) == false
        if dtype_is_int(self.dtype)
            add_int_tensors(lhs, rhs, res)
        else
            let total: int = res.size
            let i: int = 0
            let unroll_limit: int = total - 3
            while i < unroll_limit
                let a0: float = lhs.get_flat(i)
                let b0: float = rhs.get_flat(i)
                let a1: float = lhs.get_flat(i + 1)
                let b1: float = rhs.get_flat(i + 1)
                let a2: float = lhs.get_flat(i + 2)
                let b2: float = rhs.get_flat(i + 2)
                let a3: float = lhs.get_flat(i + 3)
                let b3: float = rhs.get_flat(i + 3)
                res.set_flat(i, a0 + b0)
                res.set_flat(i + 1, a1 + b1)
                res.set_flat(i + 2, a2 + b2)
                res.set_flat(i + 3, a3 + b3)
                i += 4
            end
            while i < total
                let a_val: float = lhs.get_flat(i)
                let b_val: float = rhs.get_flat(i)
                res.set_flat(i, a_val + b_val)
                i += 1
            end
        end
    end
    if lhs_tmp
        lhs.free()
    end
    if rhs_tmp
        rhs.free()
    end
    return res
end

## Element-wise subtraction with NumPy-style broadcasting (4-wide unrolled).
##
## Shapes broadcast right-aligned (size-1 dimensions stretch); incompatible
## shapes throw.
##
## ### Throws
## Broadcast-incompatible shapes, or dtype mismatch (no implicit promotion).
pub function Tensor.sub(self: Tensor, other: Tensor) -> Tensor
    assert_same_dtype(self, other)
    let out_shape = broadcast_shape(self.shape, other.shape)
    let lhs = materialized_for_shape(self, out_shape)
    let rhs = materialized_for_shape(other, out_shape)
    let lhs_tmp = materialized_is_temp(self, out_shape)
    let rhs_tmp = materialized_is_temp(other, out_shape)
    let res = Tensor.new(out_shape, self.dtype, self.device_id)
    if dtype_is_int(self.dtype)
        sub_int_tensors(lhs, rhs, res)
    else
        let total: int = res.size
        let i: int = 0
        let unroll_limit: int = total - 3
        while i < unroll_limit
            let a0: float = lhs.get_flat(i)
            let b0: float = rhs.get_flat(i)
            let a1: float = lhs.get_flat(i + 1)
            let b1: float = rhs.get_flat(i + 1)
            let a2: float = lhs.get_flat(i + 2)
            let b2: float = rhs.get_flat(i + 2)
            let a3: float = lhs.get_flat(i + 3)
            let b3: float = rhs.get_flat(i + 3)
            res.set_flat(i, a0 - b0)
            res.set_flat(i + 1, a1 - b1)
            res.set_flat(i + 2, a2 - b2)
            res.set_flat(i + 3, a3 - b3)
            i += 4
        end
        while i < total
            let a_val: float = lhs.get_flat(i)
            let b_val: float = rhs.get_flat(i)
            res.set_flat(i, a_val - b_val)
            i += 1
        end
    end
    if lhs_tmp
        lhs.free()
    end
    if rhs_tmp
        rhs.free()
    end
    return res
end

## Element-wise multiplication with NumPy-style broadcasting (4-wide unrolled Hadamard product).
##
## Shapes broadcast right-aligned (size-1 dimensions stretch); incompatible
## shapes throw.
##
## ### Throws
## Broadcast-incompatible shapes, or dtype mismatch (no implicit promotion).
pub function Tensor.mul(self: Tensor, other: Tensor) -> Tensor
    assert_same_dtype(self, other)
    let out_shape = broadcast_shape(self.shape, other.shape)
    let lhs = materialized_for_shape(self, out_shape)
    let rhs = materialized_for_shape(other, out_shape)
    let lhs_tmp = materialized_is_temp(self, out_shape)
    let rhs_tmp = materialized_is_temp(other, out_shape)
    let res = Tensor.new(out_shape, self.dtype, self.device_id)
    if device_offload_ew(lhs, rhs, res, res.size, 1) == false
        if dtype_is_int(self.dtype)
            mul_int_tensors(lhs, rhs, res)
        else
            let total: int = res.size
            let i: int = 0
            let unroll_limit: int = total - 3
            while i < unroll_limit
                let a0: float = lhs.get_flat(i)
                let b0: float = rhs.get_flat(i)
                let a1: float = lhs.get_flat(i + 1)
                let b1: float = rhs.get_flat(i + 1)
                let a2: float = lhs.get_flat(i + 2)
                let b2: float = rhs.get_flat(i + 2)
                let a3: float = lhs.get_flat(i + 3)
                let b3: float = rhs.get_flat(i + 3)
                res.set_flat(i, a0 * b0)
                res.set_flat(i + 1, a1 * b1)
                res.set_flat(i + 2, a2 * b2)
                res.set_flat(i + 3, a3 * b3)
                i += 4
            end
            while i < total
                let a_val: float = lhs.get_flat(i)
                let b_val: float = rhs.get_flat(i)
                res.set_flat(i, a_val * b_val)
                i += 1
            end
        end
    end
    if lhs_tmp
        lhs.free()
    end
    if rhs_tmp
        rhs.free()
    end
    return res
end

## Element-wise division with NumPy-style broadcasting (4-wide unrolled).
##
## Shapes broadcast right-aligned (size-1 dimensions stretch); incompatible
## shapes throw. Float division by zero follows IEEE-754 semantics
## (`inf` / `-inf` / `nan`); integer division truncates toward zero and
## throws on a zero divisor.
##
## ### Throws
## Broadcast-incompatible shapes, dtype mismatch (no implicit promotion),
## or integer division by zero.
pub function Tensor.div(self: Tensor, other: Tensor) -> Tensor
    assert_same_dtype(self, other)
    let out_shape = broadcast_shape(self.shape, other.shape)
    let lhs = materialized_for_shape(self, out_shape)
    let rhs = materialized_for_shape(other, out_shape)
    let lhs_tmp = materialized_is_temp(self, out_shape)
    let rhs_tmp = materialized_is_temp(other, out_shape)
    let res = Tensor.new(out_shape, self.dtype, self.device_id)
    if dtype_is_int(self.dtype)
        div_int_tensors(lhs, rhs, res)
    else
        let total: int = res.size
        let i: int = 0
        let unroll_limit: int = total - 3
        while i < unroll_limit
            let a0: float = lhs.get_flat(i)
            let b0: float = rhs.get_flat(i)
            let a1: float = lhs.get_flat(i + 1)
            let b1: float = rhs.get_flat(i + 1)
            let a2: float = lhs.get_flat(i + 2)
            let b2: float = rhs.get_flat(i + 2)
            let a3: float = lhs.get_flat(i + 3)
            let b3: float = rhs.get_flat(i + 3)
            res.set_flat(i, a0 / b0)
            res.set_flat(i + 1, a1 / b1)
            res.set_flat(i + 2, a2 / b2)
            res.set_flat(i + 3, a3 / b3)
            i += 4
        end
        while i < total
            let a_val: float = lhs.get_flat(i)
            let b_val: float = rhs.get_flat(i)
            res.set_flat(i, a_val / b_val)
            i += 1
        end
    end
    if lhs_tmp
        lhs.free()
    end
    if rhs_tmp
        rhs.free()
    end
    return res
end

## Integer-dtype element-wise kernels shared by `add`/`sub`/`mul`/`div`.
## Exact integer arithmetic; integer division truncates toward zero
## (C-style) and throws on a zero divisor (pre-scanned before writing).
function add_int_tensors(a: Tensor, b: Tensor, res: Tensor) -> Tensor
    let total: int = a.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        res.set_flat_int(i, a.get_flat_int(i) + b.get_flat_int(i))
        res.set_flat_int(i + 1, a.get_flat_int(i + 1) + b.get_flat_int(i + 1))
        res.set_flat_int(i + 2, a.get_flat_int(i + 2) + b.get_flat_int(i + 2))
        res.set_flat_int(i + 3, a.get_flat_int(i + 3) + b.get_flat_int(i + 3))
        i += 4
    end
    while i < total
        res.set_flat_int(i, a.get_flat_int(i) + b.get_flat_int(i))
        i += 1
    end
    return res
end

function sub_int_tensors(a: Tensor, b: Tensor, res: Tensor) -> Tensor
    let total: int = a.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        res.set_flat_int(i, a.get_flat_int(i) - b.get_flat_int(i))
        res.set_flat_int(i + 1, a.get_flat_int(i + 1) - b.get_flat_int(i + 1))
        res.set_flat_int(i + 2, a.get_flat_int(i + 2) - b.get_flat_int(i + 2))
        res.set_flat_int(i + 3, a.get_flat_int(i + 3) - b.get_flat_int(i + 3))
        i += 4
    end
    while i < total
        res.set_flat_int(i, a.get_flat_int(i) - b.get_flat_int(i))
        i += 1
    end
    return res
end

function mul_int_tensors(a: Tensor, b: Tensor, res: Tensor) -> Tensor
    let total: int = a.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        res.set_flat_int(i, a.get_flat_int(i) * b.get_flat_int(i))
        res.set_flat_int(i + 1, a.get_flat_int(i + 1) * b.get_flat_int(i + 1))
        res.set_flat_int(i + 2, a.get_flat_int(i + 2) * b.get_flat_int(i + 2))
        res.set_flat_int(i + 3, a.get_flat_int(i + 3) * b.get_flat_int(i + 3))
        i += 4
    end
    while i < total
        res.set_flat_int(i, a.get_flat_int(i) * b.get_flat_int(i))
        i += 1
    end
    return res
end

function div_int_tensors(a: Tensor, b: Tensor, res: Tensor) -> Tensor
    let total: int = a.size
    let i: int = 0
    while i < total
        if b.get_flat_int(i) == 0
            throw "Integer division by zero in Tensor.div"
        end
        i += 1
    end
    let j: int = 0
    let unroll_limit: int = total - 3
    while j < unroll_limit
        res.set_flat_int(j, a.get_flat_int(j) / b.get_flat_int(j))
        res.set_flat_int(j + 1, a.get_flat_int(j + 1) / b.get_flat_int(j + 1))
        res.set_flat_int(j + 2, a.get_flat_int(j + 2) / b.get_flat_int(j + 2))
        res.set_flat_int(j + 3, a.get_flat_int(j + 3) / b.get_flat_int(j + 3))
        j += 4
    end
    while j < total
        res.set_flat_int(j, a.get_flat_int(j) / b.get_flat_int(j))
        j += 1
    end
    return res
end

## Scales all elements by a scalar multiplier.
##
## The factor converts per element for integer storage (truncation toward
## zero applies to non-integral results).
pub function Tensor.scale(self: Tensor, factor: float) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < total
            res.set_flat_int(i, int(self.get_flat_int(i) * factor))
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < total
        let v: float = self.get_flat(j)
        res.set_flat(j, v * factor)
        j += 1
    end
    return res
end

## Element-wise negation (additive inverse of every element, exact per dtype).
pub function Tensor.neg(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < total
            res.set_flat_int(i, -self.get_flat_int(i))
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < total
        res.set_flat(j, -self.get_flat(j))
        j += 1
    end
    return res
end

## Element-wise absolute value (exact per dtype).
pub function Tensor.abs(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < total
            let v = self.get_flat_int(i)
            if v < 0
                res.set_flat_int(i, -v)
            else
                res.set_flat_int(i, v)
            end
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < total
        let w: float = self.get_flat(j)
        if w < 0.0
            res.set_flat(j, -w)
        else
            res.set_flat(j, w)
        end
        j += 1
    end
    return res
end

## Element-wise square root.
##
## Calls the `native_sqrt` runtime directly (not the `sqrt_f` stdlib
## wrapper): whole-program inference keys unannotated wrapper params by
## call-site types, and a same-stem method in the unit (`Tensor.log` once
## poisoned `log_n` this way) can silently flip them to int treatment.
## Direct native calls carry no Alya params and are immune by construction.
## Integer storage converts through float and truncates on store;
## `sqrt` of negatives yields `nan` (IEEE-754).
pub function Tensor.sqrt(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, native_sqrt(self.get_flat(i)))
        i += 1
    end
    return res
end

## Element-wise natural exponential (direct `native_exp`; see `sqrt` note).
##
## Integer storage converts through float and truncates on store.
pub function Tensor.exp(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, native_exp(self.get_flat(i)))
        i += 1
    end
    return res
end

## Element-wise natural logarithm (direct `native_log`; see `sqrt` note).
##
## Named `ln` (not `log`) so the method stem never collides with the
## `log_n`/`log2`/`log10` stdlib wrappers in a compiled unit. Integer
## storage converts through float and truncates on store; `ln(0)` yields
## `-inf`, `ln` of negatives yields `nan` (IEEE-754).
pub function Tensor.ln(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    let i: int = 0
    while i < total
        res.set_flat(i, native_log(self.get_flat(i)))
        i += 1
    end
    return res
end

## Scalar power `x^exponent` per element.
##
## Non-negative integral exponents on integer storage use exact repeated
## squaring; everything else computes `exp(exponent * ln(x))` in float
## (integer storage truncates on store). `x^0` is `1` (including `0^0`).
pub function Tensor.pow(self: Tensor, exponent: float) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype) and exponent >= 0.0 and exponent - int(exponent) == 0.0
        let count: int = int(exponent)
        let i: int = 0
        while i < total
            res.set_flat_int(i, int_pow(self.get_flat_int(i), count))
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < total
        res.set_flat(j, pow_float(self.get_flat(j), exponent))
        j += 1
    end
    return res
end

## Exact integer power by repeated squaring (`count >= 0`).
function int_pow(base, count: int)
    let r = 1
    let b = base
    let e: int = count
    while e > 0
        if e % 2 == 1
            r *= b
        end
        b *= b
        e = e / 2
    end
    return r
end

## Float power via `exp(exponent * ln(base))` with `0^0 == 1` and
## `0^negative == inf` edge handling.
function pow_float(base: float, exponent: float) -> float
    if exponent == 0.0
        return 1.0
    end
    if base == 0.0
        if exponent < 0.0
            return 1.0 / base
        end
        return 0.0
    end
    return native_exp(exponent * native_log(base))
end

## Element-wise clamp into `[lo, hi]` (exact per dtype).
pub function Tensor.clip(self: Tensor, lo: float, hi: float) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype)
        let lo_i = int(lo)
        let hi_i = int(hi)
        let i: int = 0
        while i < total
            let v = self.get_flat_int(i)
            if v < lo_i
                res.set_flat_int(i, lo_i)
            elif v > hi_i
                res.set_flat_int(i, hi_i)
            else
                res.set_flat_int(i, v)
            end
            i += 1
        end
        return res
    end
    let j: int = 0
    while j < total
        let w: float = self.get_flat(j)
        if w < lo
            res.set_flat(j, lo)
        elif w > hi
            res.set_flat(j, hi)
        else
            res.set_flat(j, w)
        end
        j += 1
    end
    return res
end

## Computes the scalar sum of all elements in the tensor (4-way unrolled).
## Integer storage accumulates exactly in integer arithmetic; the final
## total converts to float (exact below 2^53).
pub function Tensor.sum(self: Tensor) -> float
    if dtype_is_int(self.dtype)
        let acc = 0
        let total: int = self.size
        let i: int = 0
        let unroll_limit: int = total - 3
        while i < unroll_limit
            acc += (self.get_flat_int(i) + self.get_flat_int(i + 1)) + (self.get_flat_int(i + 2) + self.get_flat_int(i + 3))
            i += 4
        end
        while i < total
            acc += self.get_flat_int(i)
            i += 1
        end
        return acc + 0.0
    end
    let total_sum: float = 0.0
    let total: int = self.size
    let i: int = 0
    let unroll_limit: int = total - 3
    while i < unroll_limit
        let e0: float = self.get_flat(i)
        let e1: float = self.get_flat(i + 1)
        let e2: float = self.get_flat(i + 2)
        let e3: float = self.get_flat(i + 3)
        total_sum += (e0 + e1) + (e2 + e3)
        i += 4
    end
    while i < total
        let ei: float = self.get_flat(i)
        total_sum += ei
        i += 1
    end
    return total_sum
end

## Computes the arithmetic mean of all elements in the tensor.
##
## ### Throws
## Empty tensor.
pub function Tensor.mean(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute mean of an empty tensor"
    end
    return self.sum() / self.size
end

## Finds the minimum element value in the tensor.
##
## ### Throws
## Empty tensor.
pub function Tensor.min(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute min of an empty tensor"
    end
    if dtype_is_int(self.dtype)
        let best = self.get_flat_int(0)
        let i: int = 1
        while i < self.size
            let v = self.get_flat_int(i)
            if v < best
                best = v
            end
            i += 1
        end
        return best + 0.0
    end
    let best: float = self.get_flat(0)
    let i: int = 1
    while i < self.size
        let v: float = self.get_flat(i)
        if v < best
            best = v
        end
        i += 1
    end
    return best
end

## Finds the maximum element value in the tensor.
##
## ### Throws
## Empty tensor.
pub function Tensor.max(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute max of an empty tensor"
    end
    if dtype_is_int(self.dtype)
        let best = self.get_flat_int(0)
        let i: int = 1
        while i < self.size
            let v = self.get_flat_int(i)
            if v > best
                best = v
            end
            i += 1
        end
        return best + 0.0
    end
    let best: float = self.get_flat(0)
    let i: int = 1
    while i < self.size
        let v: float = self.get_flat(i)
        if v > best
            best = v
        end
        i += 1
    end
    return best
end

## Computes the scalar product of all elements in the tensor.
## Integer storage multiplies exactly in integer arithmetic (overflow wraps,
## C-style); the empty product is `1`.
pub function Tensor.prod(self: Tensor) -> float
    if dtype_is_int(self.dtype)
        let acc = 1
        let total: int = self.size
        let i: int = 0
        while i < total
            acc *= self.get_flat_int(i)
            i += 1
        end
        return acc + 0.0
    end
    let total_prod: float = 1.0
    let n: int = self.size
    let j: int = 0
    while j < n
        total_prod *= self.get_flat(j)
        j += 1
    end
    return total_prod
end

## Computes the population variance of all elements (divides by N).
## Integer storage converts through float (exact below 2^53).
##
## ### Throws
## Empty tensor.
pub function Tensor.variance(self: Tensor) -> float
    if self.size == 0
        throw "Cannot compute variance of an empty tensor"
    end
    let mu: float = self.mean()
    let acc: float = 0.0
    let total: int = self.size
    let i: int = 0
    while i < total
        let d: float = self.get_flat(i) - mu
        acc += d * d
        i += 1
    end
    return acc / self.size
end

## Computes the population standard deviation (`sqrt` of `variance`).
pub function Tensor.std(self: Tensor) -> float
    return native_sqrt(self.variance())
end

## Returns the flat index of the minimum element (first occurrence wins).
##
## ### Throws
## Empty tensor.
pub function Tensor.argmin(self: Tensor) -> int
    if self.size == 0
        throw "Cannot compute argmin of an empty tensor"
    end
    if dtype_is_int(self.dtype)
        let best = self.get_flat_int(0)
        let best_idx: int = 0
        let i: int = 1
        while i < self.size
            let v = self.get_flat_int(i)
            if v < best
                best = v
                best_idx = i
            end
            i += 1
        end
        return best_idx
    end
    let best_f: float = self.get_flat(0)
    let best_j: int = 0
    let j: int = 1
    while j < self.size
        let w: float = self.get_flat(j)
        if w < best_f
            best_f = w
            best_j = j
        end
        j += 1
    end
    return best_j
end

## Returns the flat index of the maximum element (first occurrence wins).
##
## ### Throws
## Empty tensor.
pub function Tensor.argmax(self: Tensor) -> int
    if self.size == 0
        throw "Cannot compute argmax of an empty tensor"
    end
    if dtype_is_int(self.dtype)
        let best = self.get_flat_int(0)
        let best_idx: int = 0
        let i: int = 1
        while i < self.size
            let v = self.get_flat_int(i)
            if v > best
                best = v
                best_idx = i
            end
            i += 1
        end
        return best_idx
    end
    let best_f: float = self.get_flat(0)
    let best_j: int = 0
    let j: int = 1
    while j < self.size
        let w: float = self.get_flat(j)
        if w > best_f
            best_f = w
            best_j = j
        end
        j += 1
    end
    return best_j
end

## Merges two sorted index runs `[lo, mid)` + `[mid, hi)` by tensor value.
## Takes the left run on ties (stable); NaN order is unspecified.
function mergesort_index_step(t: Tensor, idx: Tensor, tmp: Tensor, n: int, width: int, is_int: int)
    let lo: int = 0
    while lo < n
        let mid: int = lo + width
        if mid > n
            mid = n
        end
        let hi: int = lo + width * 2
        if hi > n
            hi = n
        end
        let a: int = lo
        let b: int = mid
        let k: int = lo
        while a < mid and b < hi
            let take_b: int = 0
            if is_int == 1
                if t.get_flat_int(idx.get_flat_int(b)) < t.get_flat_int(idx.get_flat_int(a))
                    take_b = 1
                end
            else
                if t.get_flat(idx.get_flat_int(b)) < t.get_flat(idx.get_flat_int(a))
                    take_b = 1
                end
            end
            if take_b == 1
                tmp.set_flat_int(k, idx.get_flat_int(b))
                b += 1
            else
                tmp.set_flat_int(k, idx.get_flat_int(a))
                a += 1
            end
            k += 1
        end
        while a < mid
            tmp.set_flat_int(k, idx.get_flat_int(a))
            a += 1
            k += 1
        end
        while b < hi
            tmp.set_flat_int(k, idx.get_flat_int(b))
            b += 1
            k += 1
        end
        let c: int = lo
        while c < hi
            idx.set_flat_int(c, tmp.get_flat_int(c))
            c += 1
        end
        lo = hi
    end
end

## Returns ascending sort positions as an Int32 index tensor.
##
## Bottom-up mergesort over flat positions (stable; integer storage
## compares exactly). Empty tensors yield an empty index tensor.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A rank-1 Int32 `Tensor` of flat indices that would sort the elements.
pub function Tensor.argsort(self: Tensor) -> Tensor
    let n: int = self.size
    let idx = Tensor.new([n], 2, self.device_id)
    let i: int = 0
    while i < n
        idx.set_flat_int(i, i)
        i += 1
    end
    let tmp = Tensor.new([n], 2, self.device_id)
    let is_int: int = 0
    if dtype_is_int(self.dtype)
        is_int = 1
    end
    let width: int = 1
    while width < n
        mergesort_index_step(self, idx, tmp, n, width, is_int)
        width *= 2
    end
    tmp.free()
    return idx
end

## Returns all elements sorted ascending as a rank-1 tensor.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A new 1D `Tensor` with the sorted values.
pub function Tensor.sort(self: Tensor) -> Tensor
    let order = self.argsort()
    let res = Tensor.new([self.size], self.dtype, self.device_id)
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < self.size
            res.set_flat_int(i, self.get_flat_int(order.get_flat_int(i)))
            i += 1
        end
        order.free()
        return res
    end
    let j: int = 0
    while j < self.size
        res.set_flat(j, self.get_flat(order.get_flat_int(j)))
        j += 1
    end
    order.free()
    return res
end

## Returns the `k` largest values, sorted descending, as a rank-1 tensor.
##
## Pair with `argsort` when positions are needed.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `k`: Value count (`0 <= k <= size`).
##
## ### Returns
## A new 1D `Tensor` with the top-`k` values in descending order.
##
## ### Throws
## `k` outside `0..=size`.
pub function Tensor.topk(self: Tensor, k: int) -> Tensor
    if k < 0 or k > self.size
        throw "Tensor.topk requires 0 <= k <= size"
    end
    let order = self.argsort()
    let res = Tensor.new([k], self.dtype, self.device_id)
    if dtype_is_int(self.dtype)
        let i: int = 0
        while i < k
            res.set_flat_int(i, self.get_flat_int(order.get_flat_int(self.size - 1 - i)))
            i += 1
        end
        order.free()
        return res
    end
    let j: int = 0
    while j < k
        res.set_flat(j, self.get_flat(order.get_flat_int(self.size - 1 - j)))
        j += 1
    end
    order.free()
    return res
end

## Returns flat-order prefix sums with the same shape as the input.
##
## Result element `i` holds the sum of flat elements `0..=i`. Integer
## storage accumulates exactly (overflow wraps, C-style).
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A new `Tensor` with cumulative sums.
pub function Tensor.cumsum(self: Tensor) -> Tensor
    let res = Tensor.new(self.shape, self.dtype, self.device_id)
    let total: int = self.size
    if dtype_is_int(self.dtype)
        let acc = 0
        let i: int = 0
        while i < total
            acc += self.get_flat_int(i)
            res.set_flat_int(i, acc)
            i += 1
        end
        return res
    end
    let running: float = 0.0
    let j: int = 0
    while j < total
        running += self.get_flat(j)
        res.set_flat(j, running)
        j += 1
    end
    return res
end

## Returns a new Tensor view with a reshaped dimension configuration.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `new_shape`: Reshaped dimension size array.
##
## ### Returns
## The reshaped `Tensor` view sharing the same buffer.
##
## ### Throws
## Element-count mismatch (returns the input silently would propagate a
## wrong shape downstream, so it throws instead).
pub function Tensor.reshape(self: Tensor, new_shape: array) -> Tensor
    let new_size: int = compute_size(new_shape)
    if new_size != self.size
        throw "Cannot reshape tensor: element count mismatch"
    end
    let new_strides = compute_strides(new_shape)
    return Tensor { shape: new_shape, strides: new_strides, size: new_size, dtype: self.dtype, device_id: self.device_id, data: self.data }
end

## Returns a flattened 1D view of the tensor.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A `[size]`-shaped `Tensor` view sharing the same buffer (only the
## owner frees it; freeing a view double-frees the buffer).
pub function Tensor.flatten(self: Tensor) -> Tensor
    return self.reshape([self.size])
end

## Returns the 2D transpose of the tensor as a new contiguous tensor.
##
## The result owns a freshly allocated buffer in row-major order (not a
## strided view), so flat element-wise kernels keep working on it.
##
## ### Parameters
## - `self`: The target rank-2 `Tensor` instance.
##
## ### Returns
## A new `[cols, rows]`-shaped `Tensor`.
##
## ### Throws
## Non-2D input.
pub function Tensor.transpose(self: Tensor) -> Tensor
    if len(self.shape) != 2
        throw "Tensor.transpose requires a 2D tensor"
    end
    let rows: int = self.shape[0]
    let cols: int = self.shape[1]
    let res = Tensor.new([cols, rows], self.dtype, self.device_id)
    let i: int = 0
    while i < rows
        let j: int = 0
        while j < cols
            res.set_2d(j, i, self.get_2d(i, j))
            j += 1
        end
        i += 1
    end
    return res
end

## Returns a broadcast view of the tensor stretched to `shape`.
##
## Size-1 dimensions stretch with stride `0` (no data is copied); every
## other dimension must already match. Throws when `shape` is incompatible.
## The view aliases the same buffer: writes through either handle are
## visible in the other, and only the owner frees the buffer.
##
## Element-wise operations (`add`/`sub`/`mul`/`div`) broadcast implicitly,
## so this is needed only when the stretched view itself is required.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `shape`: Target shape array with rank >= `self` rank.
##
## ### Returns
## A `Tensor` view sharing the same buffer with broadcast strides.
##
## ### Throws
## Target rank below `self` rank, empty target dimensions, or an
## incompatible dimension pair.
pub function Tensor.broadcast_to(self: Tensor, shape: array) -> Tensor
    let rank: int = len(shape)
    let srank: int = len(self.shape)
    if srank > rank
        throw "Cannot broadcast tensor to fewer dimensions"
    end
    let off: int = rank - srank
    let new_strides = []
    let d: int = 0
    while d < rank
        new_strides.push(0)
        d += 1
    end
    let e: int = 0
    while e < rank
        let want: int = shape[e]
        let k: int = e - off
        if k < 0
            if want < 1
                throw "Tensor broadcast_to rejects empty target dimensions"
            end
            new_strides[e] = 0
        else
            let have: int = self.shape[k]
            if have == 1
                new_strides[e] = 0
            elif have == want
                new_strides[e] = self.strides[k]
            else
                throw "Tensor shapes are not broadcast-compatible"
            end
        end
        e += 1
    end
    return Tensor { shape: shape, strides: new_strides, size: compute_size(shape), dtype: self.dtype, device_id: self.device_id, data: self.data }
end

## Returns a view with all size-1 dimensions removed.
##
## Shares the buffer (see `reshape`); a fully-squeezed rank-0 shape `[]`
## still addresses its single element.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## A `Tensor` view with squeezed strides.
pub function Tensor.squeeze(self: Tensor) -> Tensor
    let ns = []
    for d in self.shape
        if d != 1
            ns.push(d)
        end
    end
    return self.reshape(ns)
end

## Returns a view with a size-1 dimension inserted at `dim`.
##
## Shares the buffer (see `reshape`); `dim` must satisfy `0 <= dim <= rank`.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `dim`: Insertion position.
##
## ### Returns
## A `Tensor` view with the widened shape.
##
## ### Throws
## Insertion `dim` outside `0..=rank`.
pub function Tensor.unsqueeze(self: Tensor, dim: int) -> Tensor
    let rank: int = len(self.shape)
    if dim < 0 or dim > rank
        throw "Tensor.unsqueeze dim out of range"
    end
    let ns = []
    let i: int = 0
    while i < dim
        ns.push(self.shape[i])
        i += 1
    end
    ns.push(1)
    while i < rank
        ns.push(self.shape[i])
        i += 1
    end
    return self.reshape(ns)
end

## Returns a copy with dimensions reordered by `axes`.
##
## Unlike `transpose` (2D-only), `permute` handles any rank. The result is
## a fresh contiguous tensor (never a strided view), so flat kernels keep
## working on it. `axes` must list every dimension exactly once.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `axes`: New order of dimensions (a permutation of `0..rank-1`).
##
## ### Returns
## A new contiguous `Tensor` with permuted shape.
##
## ### Throws
## `axes` with wrong length, out-of-range entries, or repeats.
pub function Tensor.permute(self: Tensor, axes: array) -> Tensor
    let rank: int = len(self.shape)
    if len(axes) != rank
        throw "Tensor.permute axes must list every dimension once"
    end
    let new_shape = []
    let mapped = []
    let i: int = 0
    while i < rank
        let ax: int = axes[i]
        if ax < 0 or ax >= rank
            throw "Tensor.permute axis out of range"
        end
        let k: int = 0
        while k < i
            if axes[k] == ax
                throw "Tensor.permute axes must not repeat"
            end
            k += 1
        end
        new_shape.push(self.shape[ax])
        mapped.push(self.strides[ax])
        i += 1
    end
    let res = Tensor.new(new_shape, self.dtype, self.device_id)
    let total: int = res.size
    let is_int: int = 0
    if dtype_is_int(self.dtype)
        is_int = 1
    end
    let f: int = 0
    while f < total
        let rem: int = f
        let src_idx: int = 0
        let d: int = rank - 1
        while d >= 0
            let dim: int = new_shape[d]
            let coord: int = rem % dim
            rem = (rem - coord) / dim
            src_idx += coord * mapped[d]
            d -= 1
        end
        if is_int == 1
            res.set_flat_int(f, self.get_flat_int(src_idx))
        else
            res.set_flat(f, self.get_flat(src_idx))
        end
        f += 1
    end
    return res
end

## Returns a contiguous copy sliced along one dimension (`step` is 1).
##
## Bounds are strict: `0 <= start <= stop <= shape[dim]`, otherwise throws.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `dim`: Dimension to slice.
## - `start`: First index (inclusive).
## - `stop`: End index (exclusive).
##
## ### Returns
## A new contiguous `Tensor` holding the sliced elements.
##
## ### Throws
## Out-of-range `dim`, or bounds violating `0 <= start <= stop <= shape[dim]`.
pub function Tensor.slice(self: Tensor, dim: int, start: int, stop: int) -> Tensor
    let rank: int = len(self.shape)
    if dim < 0 or dim >= rank
        throw "Tensor.slice dim out of range"
    end
    let extent: int = self.shape[dim]
    if start < 0 or stop < start or stop > extent
        throw "Tensor.slice bounds out of range"
    end
    let new_shape = []
    let i: int = 0
    while i < rank
        if i == dim
            new_shape.push(stop - start)
        else
            new_shape.push(self.shape[i])
        end
        i += 1
    end
    let res = Tensor.new(new_shape, self.dtype, self.device_id)
    let total: int = res.size
    let is_int: int = 0
    if dtype_is_int(self.dtype)
        is_int = 1
    end
    let f: int = 0
    while f < total
        let rem: int = f
        let src_idx: int = 0
        let d: int = rank - 1
        while d >= 0
            let dd: int = new_shape[d]
            let coord: int = rem % dd
            rem = (rem - coord) / dd
            if d == dim
                coord += start
            end
            src_idx += coord * self.strides[d]
            d -= 1
        end
        if is_int == 1
            res.set_flat_int(f, self.get_flat_int(src_idx))
        else
            res.set_flat(f, self.get_flat(src_idx))
        end
        f += 1
    end
    return res
end

## Concatenates a list of tensors along `dim` into a new contiguous tensor.
##
## All inputs must share rank and dtype; every dimension except `dim`
## must match. Result placement follows the first tensor.
##
## ### Parameters
## - `tensors`: Non-empty array of `Tensor` instances.
## - `dim`: Dimension to concatenate along.
##
## ### Returns
## A new contiguous `Tensor`.
##
## ### Throws
## Empty input list, out-of-range `dim`, differing ranks or dtypes, or
## mismatched non-concat dimensions.
pub function Tensor.concat(tensors: array, dim: int) -> Tensor
    if len(tensors) == 0
        throw "Tensor.concat requires at least one tensor"
    end
    let first: Tensor = tensors[0]
    let rank: int = len(first.shape)
    if dim < 0 or dim >= rank
        throw "Tensor.concat dim out of range"
    end
    let out_shape = []
    let i: int = 0
    while i < rank
        out_shape.push(first.shape[i])
        i += 1
    end
    out_shape[dim] = 0
    let q: int = 0
    while q < len(tensors)
        let t: Tensor = tensors[q]
        if len(t.shape) != rank
            throw "Tensor.concat requires equal ranks"
        end
        if t.dtype != first.dtype
            throw "Tensor.concat requires identical dtypes"
        end
        let e: int = 0
        while e < rank
            if e != dim and t.shape[e] != first.shape[e]
                throw "Tensor.concat requires matching non-concat dimensions"
            end
            e += 1
        end
        out_shape[dim] = out_shape[dim] + t.shape[dim]
        q += 1
    end
    let res = Tensor.new(out_shape, first.dtype, first.device_id)
    let is_int: int = 0
    if dtype_is_int(first.dtype)
        is_int = 1
    end
    let base: int = 0
    let w: int = 0
    while w < len(tensors)
        let s: Tensor = tensors[w]
        let edge: int = s.shape[dim]
        let total: int = s.size
        let f: int = 0
        while f < total
            let rem: int = f
            let dst_idx: int = 0
            let src_idx: int = 0
            let d: int = rank - 1
            while d >= 0
                let dd: int = s.shape[d]
                let coord: int = rem % dd
                rem = (rem - coord) / dd
                src_idx += coord * s.strides[d]
                if d == dim
                    coord += base
                end
                dst_idx += coord * res.strides[d]
                d -= 1
            end
            if is_int == 1
                res.set_flat_int(dst_idx, s.get_flat_int(src_idx))
            else
                res.set_flat(dst_idx, s.get_flat(src_idx))
            end
            f += 1
        end
        base += edge
        w += 1
    end
    return res
end

## Stacks a list of tensors along a new dimension `dim`.
##
## Equivalent to unsqueezing each input at `dim` and concatenating;
## implemented exactly that way (views are never freed).
##
## ### Parameters
## - `tensors`: Non-empty array of same-shaped, same-dtype `Tensor` instances.
## - `dim`: Position of the new dimension (`0 <= dim <= rank`).
##
## ### Returns
## A new contiguous `Tensor` with one extra dimension.
##
## ### Throws
## Empty input list (element validation delegates to `unsqueeze`/`concat`).
pub function Tensor.stack(tensors: array, dim: int) -> Tensor
    if len(tensors) == 0
        throw "Tensor.stack requires at least one tensor"
    end
    let views = []
    let q: int = 0
    while q < len(tensors)
        let t: Tensor = tensors[q]
        views.push(t.unsqueeze(dim))
        q += 1
    end
    return Tensor.concat(views, dim)
end

## Splits a tensor into `parts` equal contiguous chunks along `dim`.
##
## `shape[dim]` must divide evenly by `parts`, otherwise throws.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `parts`: Chunk count (positive).
## - `dim`: Dimension to split.
##
## ### Returns
## An array of new contiguous `Tensor` chunks (caller frees each).
##
## ### Throws
## Non-positive part count, out-of-range `dim`, or uneven division.
pub function Tensor.split(self: Tensor, parts: int, dim: int) -> array
    let rank: int = len(self.shape)
    if parts <= 0
        throw "Tensor.split requires a positive part count"
    end
    if dim < 0 or dim >= rank
        throw "Tensor.split dim out of range"
    end
    let extent: int = self.shape[dim]
    if extent % parts != 0
        throw "Tensor.split requires an evenly divisible dimension"
    end
    let chunk: int = extent / parts
    let out = []
    let p: int = 0
    while p < parts
        out.push(self.slice(dim, p * chunk, (p + 1) * chunk))
        p += 1
    end
    return out
end

## Converts all tensor elements to a standard flat Alya float array.
##
## Integer storage converts to float (exact below 2^53); use
## `to_array_int` for exact integer export.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## Flat float element array.
pub function Tensor.to_array(self: Tensor) -> array
    let arr = []
    let total: int = self.size
    let i: int = 0
    while i < total
        let v: float = self.get_flat(i)
        arr.push(v)
        i += 1
    end
    return arr
end

## Converts all tensor elements to a flat Alya integer array.
##
## Integer storage exports exactly (including Int64); float storage
## truncates toward zero.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
##
## ### Returns
## Flat integer element array.
pub function Tensor.to_array_int(self: Tensor) -> array
    let arr = []
    let total: int = self.size
    let i: int = 0
    while i < total
        arr.push(self.get_flat_int(i))
        i += 1
    end
    return arr
end

## Reads one element as raw storage bits (sign ignored, low bits exact).
## The text serializer stores these integers, so every dtype round-trips
## bit-exactly without float formatting loss.
function tensor_read_bits(data: ptr, idx: int, dtype: int)
    when dtype
        is 1 then return read_i32(data, idx * 4)
        is 2 then return read_i32(data, idx * 4)
        else return read_int(data, idx * 8)
    end
end

## Writes one element from raw storage bits (low bits stored verbatim).
function tensor_write_bits(data: ptr, idx: int, dtype: int, bits)
    when dtype
        is 1 then write_i32(data, idx * 4, bits)
        is 2 then write_i32(data, idx * 4, bits)
        else write_int(data, idx * 8, bits)
    end
end

## Returns the text after a required line prefix, or throws.
function after_prefix(line: string, prefix: string) -> string
    if starts_with(line, prefix) == 0
        throw "Tensor.load found a malformed header line"
    end
    return substring(line, len(prefix), len(line) - len(prefix))
end

## Serializes the tensor to a text file (bit-exact round-trip).
##
## Line-oriented `ALYA-TENSOR-1` format: magic, dtype, device, rank, one
## `dim` line per dimension, a `data` marker, then one raw-bit integer per
## element. Floats travel as integer bit patterns (never `%g`), so every
## dtype — including Int64 and subnormals — round-trips exactly.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `path`: Destination file path.
##
## ### Returns
## Integer result from the file write operation.
pub function Tensor.save(self: Tensor, path: string) -> int
    let out = "ALYA-TENSOR-1\n"
    out += "dtype " + str(self.dtype) + "\n"
    out += "device " + str(self.device_id) + "\n"
    out += "rank " + str(len(self.shape)) + "\n"
    let d: int = 0
    while d < len(self.shape)
        out += "dim " + str(self.shape[d]) + "\n"
        d += 1
    end
    out += "data\n"
    let i: int = 0
    while i < self.size
        out += str(tensor_read_bits(self.data, i, self.dtype)) + "\n"
        i += 1
    end
    return write_file(path, out)
end

## Loads a tensor serialized by `save` (bit-exact round-trip).
##
## ### Parameters
## - `path`: Source file path.
##
## ### Returns
## The deserialized `Tensor` instance (shape, dtype, device, and bits).
##
## ### Throws
## Unknown magic, malformed header, or element-count mismatch.
pub function Tensor.load(path: string) -> Tensor
    let rows = lines(read_file(path))
    if len(rows) < 5
        throw "Tensor.load rejects truncated files (expected ALYA-TENSOR-1)"
    end
    if rows[0] != "ALYA-TENSOR-1"
        throw "Tensor.load rejects unknown magic (expected ALYA-TENSOR-1)"
    end
    let dtype: int = int(after_prefix(rows[1], "dtype "))
    let device: int = int(after_prefix(rows[2], "device "))
    let rank: int = int(after_prefix(rows[3], "rank "))
    let shape = []
    let d: int = 0
    while d < rank
        shape.push(int(after_prefix(rows[4 + d], "dim ")))
        d += 1
    end
    if rows[4 + rank] != "data"
        throw "Tensor.load found a malformed header (expected data marker)"
    end
    let t = Tensor.new(shape, dtype, device)
    let got: int = 0
    let r: int = 5 + rank
    while r < len(rows)
        if len(rows[r]) > 0
            if got >= t.size
                throw "Tensor.load found more elements than the header shape holds"
            end
            tensor_write_bits(t.data, got, dtype, int(rows[r]))
            got += 1
        end
        r += 1
    end
    if got != t.size
        throw "Tensor.load element count mismatch against the header shape"
    end
    return t
end

## Element-wise approximate equality within an absolute tolerance.
##
## Returns `false` (rather than throwing) when shapes or dtypes differ, so
## it can be used directly as a test predicate.
##
## ### Parameters
## - `self`: The target `Tensor` instance.
## - `other`: The comparison `Tensor` instance.
## - `tol`: Maximum allowed absolute element difference.
##
## ### Returns
## `true` when shapes and dtypes match and every element pair is within `tol`.
pub function Tensor.allclose(self: Tensor, other: Tensor, tol: float = 0.000000001) -> bool
    if shapes_equal_shape(self.shape, other.shape) == false
        return false
    end
    if self.dtype != other.dtype
        return false
    end
    let total: int = self.size
    let i: int = 0
    while i < total
        let d: float = self.get_flat(i) - other.get_flat(i)
        if d < 0.0
            d = -d
        end
        if d > tol
            return false
        end
        i += 1
    end
    return true
end

## Formats the tensor using the internal formatter.
pub function Tensor.to_string(self: Tensor) -> string
    if len(self.shape) == 2
        let rows: int = self.shape[0]
        let cols: int = self.shape[1]
        return format_matrix(self.data, rows, cols, self.dtype)
    end
    return format_vector(self.data, self.size, self.dtype)
end

## Releases the 32-byte aligned heap buffer allocated for this tensor.
pub function Tensor.free(self: Tensor)
    aligned_free(self.data)
end
