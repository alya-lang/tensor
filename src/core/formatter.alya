## Internal formatting utilities for Tensor display
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/mem"

## Formats a 1D tensor row into a string representation.
pub function format_vector(data_ptr: ptr, count: int) -> string
    let res = "["
    let i: int = 0
    while i < count
        let val: float = read_float(data_ptr, i * 8)
        res += str(val)
        if i + 1 < count
            res += ", "
        end
        i += 1
    end
    res += "]"
    return res
end

## Formats a 2D tensor into a multi-row matrix representation.
##
## Assumes contiguous row-major layout, which every constructor in this
## engine guarantees (`transpose` returns a contiguous copy, never a view).
pub function format_matrix(data_ptr: ptr, rows: int, cols: int) -> string
    let res = "["
    let i: int = 0
    while i < rows
        if i > 0
            res += ", "
        end
        res += "["
        let j: int = 0
        while j < cols
            let val: float = read_float(data_ptr, (i * cols + j) * 8)
            res += str(val)
            if j + 1 < cols
                res += ", "
            end
            j += 1
        end
        res += "]"
        i += 1
    end
    res += "]"
    return res
end
