## Tensor Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines tensor data types, devices, and runtime execution configuration.

## Public enumeration of supported tensor numeric scalar data types.
pub enum TensorDtype
    Float64,
    Float32,
    Int32,
    Int64
end

## Public enumeration of execution engine devices.
pub enum TensorDevice
    CPU,
    SIMD
end

## Configuration data model holding execution parameters for the tensor engine.
pub struct TensorConfig
    device: int,
    precision: int,
    threads: int
end

## Creates a new TensorConfig with default hardware settings.
pub function new_config(device: int = 1, precision: int = 0, threads: int = 1) -> TensorConfig
    return TensorConfig(device, precision, threads)
end

## Returns a summary description of the tensor configuration.
pub function TensorConfig.summary(self: TensorConfig) -> string
    let dev_name = "CPU"
    if self.device == 1
        dev_name = "SIMD (AVX2/Neon/SSE2)"
    end
    return "TensorConfig(device: " + dev_name + ", threads: " + str(self.threads) + ")"
end
